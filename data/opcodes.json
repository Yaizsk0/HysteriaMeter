{
  // Mapa tipo de paquete → opcodes (u16 little-endian). Cada tipo admite varios valores para que
  // convivan los de antes y después de un parche. Formato hex "0x...." o decimal.
  //
  // Confirmados con una captura real del cliente global (2026-10-14):
  //   0xFFFF  bundle: [u32 LE largo descomprimido][bloque LZ4] con más frames adentro
  //   0x3804  resultado de un efecto sobre un objetivo; con flags & 0x04 lleva daño
  //   0x3805  tick de efecto periódico: type 0x0A = DoT, 0x0B / 0x09 = curación
  //   0x3645  aparición de otro jugador, con su nombre
  //   0x3641  aparición de NPC o invocación (entidad, nombre del dueño opcional, ID de NPC, posición, HP)
  //   0x8D04  muerte, con skill, ID y nombre del que mató (en dungeons llega vacío)
  //   0x364A  solo del jugador local: el primer varint es su entidad (llega en el primer bundle de
  //           cada conexión; cada cambio de zona abre conexión nueva y cambia la entidad)
  //   0x8D00  valores de una entidad: varint entidad | u8 flags | [u8 n | n × (u8 id | u32)] si flags & 0x01 |
  //           [u8 n | n × (u8 id | u64)] si flags & 0x02. Se lee entera y se emite la vida, el id 00 del bloque u64
  //           (el id 07 es el HP máximo y no se emite; los ids del bloque u32, sin identificar)
  //   0x921B  HP/MP de un miembro de la party (~1 por segundo y por miembro): varint entidad | varint hp | varint hpMax | ...
  //           Solo llega para compañeros de party, desde el primer segundo de la conexión.
  //   0x3633  datos del jugador local al entrar a una zona: varint entidad | 4 bytes | u8 | string nombre |
  //           u16 servidor | u32 ? | u8 | u32 nivel | u32 item level | ...
  //   0x3656  power (CP) del jugador local: u64 actual | u64 ? (16 bytes; llega varias veces al entrar mientras carga)
  //
  // Vistos pero todavía sin decoder:
  //   0x3802  lanzamiento de skill (fuente, skill, objetivo, posición)
  //   0x3806  estado de entidades: llega del jugador local y de NPCs, nunca de otros jugadores
  //   0x9200  lista completa de la party (entidad, GUID, ID de personaje, nombre, HP, legión); layout variable por miembro
  //   0x920E, 0x921A  estado de miembros de la party, incluido el local
  //   0x3620  una vez por conexión: u16 0 | varint entidad local | u32 0 | u32 ID de personaje | ... zlib
  //   0x371A-0x371D  movimiento de entidades (0x371D sin decodificar)
  //   0x3600  u64 LE que sube 50 por mensaje, uno cada 50 ms (INTERPRETADO: reloj del servidor)
  "opcodes": {
    "Bundle": ["0xFFFF"],
    "LocalPlayer": ["0x364A"],
    "LocalPlayerInfo": ["0x3633"],
    "EntitySpawn": ["0x3641"],
    "EntityInfo": ["0x3645"],
    "PartyMember": ["0x921B"],
    "Damage": ["0x3804"],
    "PeriodicEffect": ["0x3805"],
    "Heal": [],
    "Death": ["0x8D04"],
    "Health": ["0x8D00"],
    "LocalCombatPower": ["0x3656"]
  }
}
