<Window x:Class="HysteriaMeter.App.Dungeon.DungeonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DungeonSummaryViewModel}"
        Title="{Binding Title}"
        Width="960" Height="760" MinWidth="940" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        FontSize="13" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: mock "Modo dungeon: resumen de la run". -->
    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBright}" />
        </Style>
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,26,0" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="1">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll" Background="#14C9A25A">
                <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource Rule}" />
                <Button DockPanel.Dock="Right" Click="OnCloseClick" ToolTip="Cerrar" Cursor="Hand" Width="26" Height="26" Margin="0,6,6,6"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                          Data="M6,6 L18,18 M18,6 L6,18" />
                </Button>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copiar para Discord" Click="OnCopyClick" Cursor="Hand" Margin="0,0,10,0" VerticalAlignment="Center"
                        Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="12"
                        ToolTip="Copia el resumen como texto" />
                <StackPanel Margin="14,8,0,8">
                    <TextBlock Text="MODO DUNGEON" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" />
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBright}" />
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12,16,6">
                <StackPanel Style="{StaticResource Stat}"><TextBlock Text="ENTRADA" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Entered}" Style="{StaticResource StatValue}" /></StackPanel>
                <StackPanel Style="{StaticResource Stat}"><TextBlock Text="ÚLTIMA PELEA" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Left}" Style="{StaticResource StatValue}" /></StackPanel>
                <StackPanel Style="{StaticResource Stat}"><TextBlock Text="DURACIÓN" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Duration}" Style="{StaticResource StatValue}" /></StackPanel>
                <StackPanel Style="{StaticResource Stat}"><TextBlock Text="BOSSES" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Bosses}" Style="{StaticResource StatValue}" Foreground="#7BD88F" /></StackPanel>
                <StackPanel Style="{StaticResource Stat}"><TextBlock Text="WIPES" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Wipes}" Style="{StaticResource StatValue}" Foreground="#F08A7E" /></StackPanel>
                <StackPanel Style="{StaticResource Stat}"><TextBlock Text="MUERTES" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Deaths}" Style="{StaticResource StatValue}" Foreground="#F08A7E" /></StackPanel>
            </StackPanel>

            <!-- Línea de tiempo: trash gris, kill dorado, wipe rojo -->
            <StackPanel DockPanel.Dock="Top" Margin="16,6,16,8">
                <TextBlock Text="LÍNEA DE TIEMPO" Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Timeline}" Width="880" Height="26" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="#14FFFFFF" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SegmentItem">
                            <Border Width="{Binding Width}" Height="26" Background="{Binding Fill}" ToolTip="{Binding Tip}" CornerRadius="2">
                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="#14110A" Margin="4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,4,8,12">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="No se detectó ningún boss en esta run: solo trash." Foreground="{StaticResource TextDim}" Margin="0,8"
                               Visibility="{Binding NoBosses, Converter={StaticResource Visible}}" />

                    <!-- Una tarjeta por boss -->
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BossCard">
                                <Border Width="290" Margin="0,0,12,12" Padding="12,10" Background="{StaticResource Row}" BorderBrush="{StaticResource RowBorder}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBright}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Stats}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,8" />
                                        <ItemsControl ItemsSource="{Binding Players}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:BossPlayerRow">
                                                    <Grid Height="22" Margin="0,0,0,2">
                                                        <Border Background="#08FFFFFF" />
                                                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{Binding Bar}" />
                                                        <DockPanel Margin="6,0">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Dps}" FontWeight="Bold" Foreground="{StaticResource TextBright}" VerticalAlignment="Center" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Skulls}" Foreground="#F08A7E" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="PlayerName" Text="{Binding Name}" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                                            <Setter TargetName="PlayerName" Property="Foreground" Value="{StaticResource NameLocal}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tabla: DPS y muertes por jugador y boss -->
                    <TextBlock Text="MUERTES Y DPS POR JUGADOR Y BOSS" Style="{StaticResource StatLabel}" Margin="0,6,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,4">
                        <TextBlock Text="JUGADOR" Width="150" Style="{StaticResource StatLabel}" />
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Width="130" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="MUERTES" Width="80" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="DPS RUN" Width="80" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PlayerRow">
                                <Border Background="{StaticResource Row}" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" Padding="6,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="150" FontWeight="SemiBold" Foreground="{Binding Color}" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" Width="130" Foreground="{StaticResource Text}" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Deaths}" Width="80" Foreground="#F08A7E" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Dps}" Width="80" Foreground="{StaticResource TextBright}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Cada celda: DPS en el intento que cuenta (el kill, o el último) · ☠ muertes sumando todos los intentos."
                               FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
