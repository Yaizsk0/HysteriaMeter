<Window x:Class="HysteriaMeter.App.Dungeon.DungeonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        xmlns:local="clr-namespace:HysteriaMeter.App.Dungeon"
        xmlns:combat="clr-namespace:HysteriaMeter.Combat;assembly=HysteriaMeter.Combat"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DungeonSummaryViewModel}"
        Title="{Binding Title}" Width="1440" Height="900" MinWidth="940" MinHeight="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        FontSize="13" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}" />
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource NumberStrong}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,28,0" />
        </Style>
        <Style x:Key="LegendItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Texto de un tramo del timeline: oscuro sobre el kill, OnWipe sobre el wipe y apagado sobre el trash. -->
        <Style x:Key="SegmentText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static combat:RunSegmentKind.Kill}"><Setter Property="Foreground" Value="{DynamicResource OnAccent}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static combat:RunSegmentKind.Wipe}"><Setter Property="Foreground" Value="{DynamicResource OnWipe}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SegmentSuffix" TargetType="TextBlock" BasedOn="{StaticResource SegmentText}">
            <Setter Property="Margin" Value="3,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Suffix}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MatrixCell" TargetType="TextBlock">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MatrixHeader" TargetType="TextBlock" BasedOn="{StaticResource MatrixCell}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <!-- Celda de la matriz: un clic abre ese intento; la que no se puede abrir se ve igual, sin la mano ni el fondo al pasar. -->
        <Style x:Key="MatrixCellButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Track}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlayerBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="{x:Static vm:DungeonSummaryViewModel.BarWidth}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{DynamicResource Row}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" Opacity="0.8" CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowFrame}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ButtonIcon}" Click="OnCloseClick" ToolTip="Cerrar (Esc)"
                            Margin="12,0,0,0" Width="32" Height="32" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" Data="M2,2 L12,12 M12,2 L2,12" />
                    </Button>
                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource ButtonPrimary}" Content="Copiar para Discord"
                            Click="OnCopyClick" MinHeight="40" Padding="14,0" VerticalAlignment="Center" ToolTip="Copia el resumen como texto" />
                    <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource ButtonGhost}" Content="Exportar resumen"
                            Click="OnExportClick" MinHeight="40" Padding="14,0" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Guarda la run en Exportes como CSV: cada boss con sus intentos, wipes y el DPS y las muertes de cada jugador" />
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Margin="0,0,48,0" VerticalAlignment="Center">
                            <TextBlock Text="MODO DUNGEON · RESUMEN DE LA RUN" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource TitleFont}" FontSize="30" FontWeight="Bold" Margin="0,2,0,0" />
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center" Margin="0,8,0,8">
                            <StackPanel Style="{StaticResource Stat}"><TextBlock Text="ENTRADA" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Entered}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel Style="{StaticResource Stat}"><TextBlock Text="ÚLTIMA PELEA" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Left}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel Style="{StaticResource Stat}"><TextBlock Text="DURACIÓN" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Duration}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel Style="{StaticResource Stat}" ToolTip="Bosses derrotados sobre bosses distintos intentados">
                                <TextBlock Text="BOSSES" Style="{StaticResource StatLabel}" />
                                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource Success}"><Run Text="{Binding Bosses, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Summary.Bosses.Count, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Stat}"><TextBlock Text="WIPES" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Wipes}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}" /></StackPanel>
                            <StackPanel Style="{StaticResource Stat}" Margin="0"><TextBlock Text="MUERTES" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Deaths}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}" /></StackPanel>
                        </WrapPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Margin="24,16,24,8">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextDim}">
                                <StackPanel Style="{StaticResource LegendItem}"><Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Neutral}" /><TextBlock Text="Trash" /></StackPanel>
                                <StackPanel Style="{StaticResource LegendItem}"><Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Kill}" /><TextBlock Text="Boss (kill)" /></StackPanel>
                                <StackPanel Style="{StaticResource LegendItem}"><Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Wipe}" /><TextBlock Text="Wipe" /></StackPanel>
                                <StackPanel Style="{StaticResource LegendItem}"><Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Track}" /><TextBlock Text="Sin combate" /></StackPanel>
                            </StackPanel>
                            <TextBlock Text="LÍNEA DE TIEMPO" Style="{StaticResource SectionLabel}" />
                        </DockPanel>
                        <Border Height="34" Background="{DynamicResource Track}" CornerRadius="6">
                            <ItemsControl ItemsSource="{Binding Timeline}" Height="34">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:DungeonTimelinePanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SegmentItem">
                                        <Border Background="{Binding Fill}" ToolTip="{Binding Tip}" CornerRadius="2">
                                            <!-- El nombre se recorta si no entra; la duración o la ✕ siempre se ven. El número de una
                                                 plantilla sin nombre se recorta por el principio ("…400456"): lo que la distingue es el final. -->
                                            <DockPanel HorizontalAlignment="Center" Margin="4,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Suffix}" Style="{StaticResource SegmentSuffix}" />
                                                <local:SegmentName FullText="{Binding Name}" FromStart="{Binding KeepEnd}" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SegmentText}" TextTrimming="CharacterEllipsis" />
                                                </local:SegmentName>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Grid Margin="0,8,0,0" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextDim}" Typography.NumeralAlignment="Tabular">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="0:00 entrada" />
                            <TextBlock Grid.Column="1" Text="{Binding TimelineQuarter}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Text="{Binding TimelineHalf}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="3" Text="{Binding TimelineThreeQuarters}" HorizontalAlignment="Left" />
                            <TextBlock Grid.ColumnSpan="4" Text="{Binding Duration, StringFormat='{}{0} última pelea'}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="No se detectó ningún boss en esta run: solo trash." Foreground="{DynamicResource TextDim}" Margin="24,12"
                               Visibility="{Binding NoBosses, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Cards}" Margin="16,12,16,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BossCard">
                                <Border Margin="8,0,8,16" Style="{StaticResource CardPanel}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" FontFamily="{StaticResource NumberFont}" FontSize="16" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <DockPanel HorizontalAlignment="Left">
                                                <Border DockPanel.Dock="Right" Padding="7,2" CornerRadius="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Killed}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessSoft}" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="SIN KILL" /><Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding Killed}" Value="True"><Setter Property="Text" Value="KILL" /><Setter Property="Foreground" Value="{DynamicResource Success}" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource TitleFont}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </DockPanel>
                                        </DockPanel>
                                        <WrapPanel Margin="0,10,0,10" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextMuted}">
                                            <!-- "—" sin nombre ni plantilla; el tooltip dice por qué el número no es todo lo que se peleó -->
                                            <TextBlock Margin="0,0,18,0" ToolTip="{Binding AttemptsTip}">Intentos <Run Text="{Binding Attempts, Mode=OneWay}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" /></TextBlock>
                                            <TextBlock Margin="0,0,18,0">DPS party <Run Text="{Binding PartyDps, Mode=OneWay}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" /></TextBlock>
                                            <TextBlock>Muertes <Run Text="{Binding Deaths, Mode=OneWay}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" /></TextBlock>
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding Players}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:BossPlayerRow">
                                                    <Grid Height="24" Margin="0,0,0,3">
                                                        <ProgressBar Style="{StaticResource PlayerBar}" Value="{Binding BarWidth}" Foreground="{Binding Bar}" />
                                                        <DockPanel Margin="8,0">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Dps}" FontFamily="{StaticResource NumberFont}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Skulls}" Foreground="{DynamicResource Danger}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="PlayerName" Text="{Binding Name}" FontFamily="{StaticResource NumberFont}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            </DockPanel>
                                                        </DockPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsLocalPlayer}" Value="True"><Setter TargetName="PlayerName" Property="Foreground" Value="{DynamicResource NameLocal}" /></DataTrigger></DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,7,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="24,4,24,20">
                        <TextBlock Text="MUERTES Y DPS POR JUGADOR Y BOSS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Background="{DynamicResource CardBg}" CornerRadius="7,7,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="JUGADOR" Style="{StaticResource MatrixHeader}" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource MatrixHeader}" ToolTip="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="2" Text="MUERTES" Style="{StaticResource MatrixHeader}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="DPS RUN" Style="{StaticResource MatrixHeader}" TextAlignment="Right" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:PlayerRow">
                                            <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0">
                                                <Grid Typography.NumeralAlignment="Tabular">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MatrixCell}" FontWeight="SemiBold" Foreground="{Binding Color}" ToolTip="{Binding Name}" />
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding StyledCells}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:PlayerBossCell">
                                                                <Button Style="{StaticResource MatrixCellButton}" IsEnabled="{Binding CanOpen}" Click="OnCellClick"
                                                                        ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Tip}">
                                                                    <TextBlock Text="{Binding Text}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MatrixCell}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DeathCellText}" />
                                                                                <Style.Triggers><DataTrigger Binding="{Binding Deaths}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Text}" /></DataTrigger></Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="2" Text="{Binding Deaths}" FontWeight="SemiBold" TextAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MatrixCell}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding Deaths}" Value="—"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding Dps}" Style="{StaticResource MatrixCell}" FontWeight="SemiBold" TextAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Cada celda: DPS en el intento del kill (o el último, si no hubo kill) · ☠ muertes sumando todos los intentos. Clic en una celda abre ese intento."
                                   Style="{StaticResource SectionLabel}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
