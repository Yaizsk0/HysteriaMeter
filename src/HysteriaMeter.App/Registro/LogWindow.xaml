<Window x:Class="HysteriaMeter.App.Registro.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        xmlns:combat="clr-namespace:HysteriaMeter.Combat;assembly=HysteriaMeter.Combat"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LogViewModel}"
        Title="Registro de la pelea"
        Width="700" Height="460" MinWidth="480" MinHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        FontSize="12" Foreground="{StaticResource Text}" FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
    </Window.Resources>

    <!-- Marco con el borde del acento (GoldDim), como WindowFrame; el fondo sigue translúcido hasta la pista de cada ventana. -->
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource GoldDim}" BorderThickness="1">
        <DockPanel>
            <!-- Cabecera: se arrastra la ventana desde acá -->
            <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll" Background="Transparent">
                <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource Rule}" />
                <Button DockPanel.Dock="Right" Click="OnCloseClick" ToolTip="Cerrar" Cursor="Hand" Width="26" Height="26" Margin="0,6,6,6"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                          Data="M6,6 L18,18 M18,6 L6,18" />
                </Button>
                <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding ReloadCommand}" Cursor="Hand" Margin="0,0,8,0"
                        Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="REGISTRO DE LA PELEA" Margin="12,9,0,9" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Filtros -->
            <DockPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Margin="10,0,0,0" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                <CheckBox DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text}"
                          IsChecked="{Binding OnlyFocus}" Visibility="{Binding HasFocus, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding FocusName, StringFormat='Solo {0}'}" />
                </CheckBox>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBg}" Foreground="{StaticResource Text}"
                         CaretBrush="{DynamicResource Gold}" BorderBrush="{StaticResource Stroke}" Padding="4,2"
                         ToolTip="Buscar por jugador, objetivo, skill o modificador (crítico, espalda...)" />
            </DockPanel>

            <!-- Columnas -->
            <Grid DockPanel.Dock="Top" Margin="18,0,18,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIEMPO" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="1" Text="DE" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="2" Text="A" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="3" Text="SKILL" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="4" Text="MONTO" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="DETALLE" Style="{StaticResource HeaderCell}" Margin="10,0,0,0" />
            </Grid>

            <ListBox ItemsSource="{Binding Lines}" Margin="10,0,10,12" Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,1" />
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LogLine">
                        <Grid x:Name="Line">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource TextDim}" />
                            <TextBlock Grid.Column="1" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Target}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="3" Text="{Binding Skill}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AmountText" Grid.Column="4" Text="{Binding Amount}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource TextBright}" />
                            <TextBlock Grid.Column="5" Text="{Binding Flags}" Margin="10,0,0,0" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static combat:LogKind.Heal}">
                                <Setter TargetName="AmountText" Property="Foreground" Value="{StaticResource Healing}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static combat:LogKind.Death}">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource DangerSoft}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
