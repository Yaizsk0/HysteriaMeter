<Window x:Class="HysteriaMeter.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        xmlns:local="clr-namespace:HysteriaMeter.App.History"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MeterViewModel}"
        Title="Historial"
        Width="1040" Height="700" MinWidth="940" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: mock "Historial". Esc cierra (OnKeyDown); Alt+← y Alt+→ recorren las peleas como en el overlay. -->
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding OlderFightCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NewerFightCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <local:SameValueConverter x:Key="Same" />

        <!-- Celdas de la fila: 10 px entre columnas, como el gap del mock (el ancho de cada columna lo incluye) -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource NumberStrong}">
            <Setter Property="FontSize" Value="{StaticResource NumberSizeSection}" />
        </Style>
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowFrame}">
        <DockPanel>
            <!-- Cabecera: título, búsqueda, chips de filtro y contador; se arrastra para mover la ventana -->
            <Border DockPanel.Dock="Top" Padding="{StaticResource PaddingWindowHeader}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1"
                    Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ButtonIcon}" Click="OnCloseClick" ToolTip="Cerrar (Esc)" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.6" Data="M6,6 L18,18 M18,6 L6,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryCountText}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDim}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Background="Transparent"
                               ToolTip="Peleas que dejan la búsqueda y el filtro, entre las últimas 200 guardadas" />
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Historial" Style="{StaticResource WindowTitle}" VerticalAlignment="Center" Margin="0,0,28,0" />

                        <!-- Búsqueda: lupa y caja sin borde propio; el marco se pinta del acento con el foco -->
                        <Border x:Name="SearchBox" Height="36" Padding="10,0" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource InputBg}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Cursor="IBeam">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="9" Height="9" Stroke="{DynamicResource TextDim}" StrokeThickness="1.6" />
                                        <Path Data="M10.5,10.5 L14,14" Stroke="{DynamicResource TextDim}" StrokeThickness="1.6" />
                                    </Canvas>
                                </Viewbox>
                                <Grid Width="220" VerticalAlignment="Center">
                                    <TextBox x:Name="Search" Style="{StaticResource InputBox}" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                             AutomationProperties.Name="Buscar" ToolTip="Buscar por boss o por nota" />
                                    <TextBlock Text="Buscar boss o nota" Foreground="{DynamicResource TextDim}" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Chips excluyentes -->
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HistoryFilter" Content="Todas" IsChecked="{Binding FilterAll}" VerticalAlignment="Center" />
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HistoryFilter" Content="Solo kills" IsChecked="{Binding OnlyKills}" VerticalAlignment="Center"
                                     ToolTip="Bosses derrotados (✓)" />
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HistoryFilter" Content="Solo bosses" IsChecked="{Binding FilterBosses}" VerticalAlignment="Center"
                                     ToolTip="Kills y wipes: peleas de al menos 30 s con casi todo el daño a un objetivo, como en el modo dungeon" />
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HistoryFilter" Content="Esta semana" IsChecked="{Binding FilterThisWeek}" VerticalAlignment="Center"
                                     ToolTip="Los últimos 7 días" />
                        <ComboBox ItemsSource="{Binding HistoryCharacters}" SelectedItem="{Binding SelectedCharacter}" MinWidth="120" Height="32" VerticalAlignment="Center"
                                  FontSize="{StaticResource FontSizeSmall}" ToolTip="Personaje: récords, intentos y percentiles se cuentan por personaje"
                                  Visibility="{Binding HasSeveralCharacters, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Peleas agrupadas por run; clic en una la muestra en el overlay y la ventana queda abierta -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding HistoryRuns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HistoryRun">
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel Margin="8,6">
                                            <!-- Modo dungeon: resumen de toda la run -->
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ButtonLink}" Content="Resumen de la run" VerticalAlignment="Bottom"
                                                    ToolTip="Modo dungeon: cada boss, sus intentos y cuántas veces murió cada uno"
                                                    Visibility="{Binding CanSummarize, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.OpenRunSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding First}" />
                                            <!-- Un solo TextBlock: los tres textos quedan alineados por la base, como en el mock -->
                                            <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" ToolTip="{Binding TitleTip}"><Run
                                                Text="{Binding Title, Mode=OneWay}" FontFamily="{StaticResource TitleFont}" FontSize="{StaticResource NumberSizeRowValue}" FontWeight="Bold" /><Run
                                                Text="&#x2003;" FontSize="10" /><Run
                                                Text="{Binding When, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDim}" /><Run
                                                Text="&#x2003;" FontSize="10" /><Run
                                                Text="{Binding Summary, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}" /></TextBlock>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Fights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:HistoryItem">
                                                    <Button Command="{Binding DataContext.OpenEncounterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" ToolTip="{Binding RowTip}"
                                                            Foreground="{DynamicResource Text}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Frame" Height="40" Padding="10,0" CornerRadius="{StaticResource RadiusControl}"
                                                                        Background="{DynamicResource RowSubtle}" BorderBrush="Transparent" BorderThickness="1">
                                                                    <ContentPresenter VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GoldDim}" />
                                                                    </Trigger>
                                                                    <!-- La pelea que muestra el overlay -->
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource Same}">
                                                                                <Binding Path="Id" />
                                                                                <Binding Path="DataContext.PinnedHistoryId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentFaint}" />
                                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>

                                                        <Grid Typography.NumeralAlignment="Tabular">
                                                            <Grid.ColumnDefinitions>
                                                                <!-- Las del mock (22, 1fr, duración, DPS, delta, percentil) más MUERTES; cada ancho incluye el gap de 10 -->
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="54" />
                                                                <ColumnDefinition Width="150" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Insignia: ✓ kill, ✕ wipe, · trash (BossRules, como el modo dungeon) -->
                                                            <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource TagNeutralBg}" />
                                                                        <Setter Property="ToolTip" Value="Trash: pelea corta o con el daño repartido entre varios bichos" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsKill}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                                                                <Setter Property="ToolTip" Value="Boss derrotado" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsWipe}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                                                                <Setter Property="ToolTip" Value="Wipe: el boss no murió" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="{StaticResource FontSizeMicro}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="·" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsKill}" Value="True">
                                                                                    <Setter Property="Text" Value="✓" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsWipe}" Value="True">
                                                                                    <Setter Property="Text" Value="✕" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Objetivo, intento y nota en la misma línea, como el mock (gap 8). Si no entra, se recorta
                                                                 el objetivo, como el span con ellipsis del mock: el intento siempre se ve y la nota tiene
                                                                 un ancho máximo con su propio recorte (completa en el tooltip de la fila). El DockPanel
                                                                 mide primero lo que va a la derecha y le deja al objetivo lo que sobra; alineado a la
                                                                 izquierda, el intento y la nota quedan pegados al objetivo y no al borde. -->
                                                            <DockPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock DockPanel.Dock="Right" MaxWidth="120" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding NoteInline, Mode=OneWay}" FontSize="{StaticResource FontSizeCaption}" FontStyle="Italic"
                                                                           Foreground="{DynamicResource TextMuted}" />
                                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Text="{Binding AttemptInline, Mode=OneWay}"
                                                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextDim}" />
                                                                <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                                                                    <Run Foreground="{DynamicResource Gold}" FontWeight="SemiBold"><Run.Style>
                                                                        <Style TargetType="Run">
                                                                            <Setter Property="Text" Value="" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRecord}" Value="True">
                                                                                    <Setter Property="Text" Value="★ " />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Run.Style></Run><Run Text="{Binding TargetText, Mode=OneWay}" FontWeight="SemiBold" />
                                                                </TextBlock>
                                                            </DockPanel>

                                                            <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding DurationText}" Foreground="{DynamicResource TextMuted}" />

                                                            <TextBlock Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource NumberStrong}"
                                                                       FontSize="{StaticResource NumberSizeRowName}" Text="{Binding LocalDpsText}" />

                                                            <!-- Contra el intento anterior contra ese boss, solo en las kills -->
                                                            <TextBlock Grid.Column="4" Text="{Binding Delta}" FontSize="{StaticResource FontSizeSmall}" ToolTip="Tu DPS contra el intento anterior contra este objetivo">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DeltaPositive}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding DeathsText}" FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{DynamicResource Danger}" ToolTip="Muertes de la party en la pelea" />

                                                            <!-- Percentil: pista con el largo del percentil y el número en el color de su franja -->
                                                            <DockPanel Grid.Column="6" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent"
                                                                       ToolTip="Percentil entre tus intentos contra este objetivo (100 = tu mejor)">
                                                                <TextBlock DockPanel.Dock="Right" Width="26" Margin="8,0,0,0" TextAlignment="Right" FontWeight="SemiBold"
                                                                           Text="{Binding PercentileNumber}" Foreground="{Binding PercentileBrush}" />
                                                                <Grid Height="6" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource Track}" CornerRadius="{StaticResource RadiusBar}" />
                                                                    <Border Background="{Binding PercentileBrush}" CornerRadius="{StaticResource RadiusBar}" RenderTransformOrigin="0,0.5"
                                                                            Visibility="{Binding HasPercentile, Converter={StaticResource Visible}}">
                                                                        <Border.RenderTransform>
                                                                            <ScaleTransform ScaleX="{Binding PercentileRatio}" />
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                </Grid>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Hay más peleas de las que entran: cómo llegar a las anteriores -->
                        <TextBlock Text="{Binding HistoryMoreText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="8,4,8,0"
                                   Visibility="{Binding HasHistoryMoreText, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Lista vacía: no hay peleas guardadas, o nada coincide -->
                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding HistoryEmptyText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasHistoryEmptyText, Converter={StaticResource Visible}}" />

                <!-- TU PROGRESO: el boss de la fila marcada (o el que deja el filtro) -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource Rule}" BorderThickness="1,0,0,0" Padding="18,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding Progress.Title}" Style="{StaticResource SectionLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Progress.EmptyText}" TextWrapping="Wrap" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProgress}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Visibility="{Binding HasProgress, Converter={StaticResource Visible}}">
                            <!-- Un intento por barra, del más viejo al más nuevo; el color es su percentil entre todos -->
                            <Border Height="120" Padding="0,0,0,4" BorderBrush="{DynamicResource Track}" BorderThickness="0,0,0,1" Background="Transparent"
                                    ToolTip="{Binding Progress.Summary}">
                                <!-- Las barras se reparten el ancho con 4 px entre ellas (el margen negativo saca el de las puntas) -->
                                <ItemsControl ItemsSource="{Binding Progress.Bars}" Margin="-2,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ProgressBarItem">
                                            <Border Height="{Binding Height}" MaxWidth="24" Margin="2,0" VerticalAlignment="Bottom" CornerRadius="2,2,0,0"
                                                    Background="{Binding Fill}" ToolTip="{Binding Tip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <DockPanel Margin="0,6,0,12" TextElement.FontSize="{StaticResource FontSizeCaption}" TextElement.Foreground="{DynamicResource TextDim}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Progress.To}" />
                                <TextBlock Text="{Binding Progress.From}" />
                            </DockPanel>

                            <UniformGrid Columns="2" Margin="0,0,0,2">
                                <StackPanel Style="{StaticResource Stat}" ToolTip="Tu mejor DPS contra este objetivo">
                                    <TextBlock Text="MEJOR" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding Progress.Best}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}" ToolTip="La mitad de tus intentos estuvo por encima y la otra mitad por debajo">
                                    <TextBlock Text="MEDIANA" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding Progress.Median}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}" ToolTip="Kills sobre las peleas contra este objetivo con tu DPS">
                                    <TextBlock Text="KILLS" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding Progress.Kills}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Stat}" ToolTip="Muertes de la party sumando esas peleas">
                                    <TextBlock Text="MUERTES" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding Progress.Deaths}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Leyenda de los colores del percentil (mismos umbrales que HistoryItem.TierBrush) -->
                        <TextBlock Text="Percentil, colores como Warcraft Logs:" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                        <WrapPanel TextElement.FontSize="{StaticResource FontSizeCaption}">
                            <TextBlock Text="gris &lt;25" Foreground="{DynamicResource Percentile0}" Margin="0,0,6,0" />
                            <TextBlock Text="verde 25+" Foreground="{DynamicResource Percentile25}" Margin="0,0,6,0" />
                            <TextBlock Text="azul 50+" Foreground="{DynamicResource Percentile50}" Margin="0,0,6,0" />
                            <TextBlock Text="violeta 75+" Foreground="{DynamicResource Percentile75}" Margin="0,0,6,0" />
                            <TextBlock Text="naranja 95+" Foreground="{DynamicResource Percentile95}" Margin="0,0,6,0" />
                            <TextBlock Text="dorado 100" Foreground="{DynamicResource Percentile100}" />
                        </WrapPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
