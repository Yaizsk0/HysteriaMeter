<Window x:Class="HysteriaMeter.App.Detail.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ActorDetailViewModel}"
        Title="{Binding Name, StringFormat='Detalle · {0}'}"
        Width="640" Height="420" MinWidth="460" MinHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        FontSize="13" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: mocks/Detalle.dc.html, sección "Desglose por skill". -->
    <Window.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,22,0" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBright}" />
        </Style>
        <DataTemplate x:Key="SkillRowCells" DataType="vm:SkillRowViewModel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBright}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Note}" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Damage}" Style="{StaticResource Cell}" Foreground="{StaticResource TextBright}" />
                <TextBlock Grid.Column="2" Text="{Binding Share}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="3" Text="{Binding Hits}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="4" Text="{Binding Critical}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="5" Text="{Binding Back}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="6" Text="{Binding MaxHit}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="7" Text="{Binding Average}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="8" Text="{Binding Dps}" Style="{StaticResource Cell}" Foreground="{StaticResource TextBright}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="1">
        <DockPanel>
            <!-- Cabecera: se arrastra la ventana desde acá -->
            <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll" Background="#14C9A25A">
                <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource Rule}" />
                <Button DockPanel.Dock="Right" Click="OnCloseClick" ToolTip="Cerrar" Cursor="Hand" Width="26" Height="26" Margin="0,6,6,6"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                          Data="M6,6 L18,18 M18,6 L6,18" />
                </Button>
                <StackPanel Orientation="Horizontal" Margin="12,6,0,6" VerticalAlignment="Center">
                    <Border Width="12" Height="12" BorderBrush="{Binding Accent}" BorderThickness="1" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" Foreground="{Binding Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Target, StringFormat='·  {0}'}" Margin="8,0,0,0" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="(no está en el encuentro actual)" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                               Visibility="{Binding IsMissing, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>

            <!-- Resumen -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,10,14,8">
                <StackPanel Style="{StaticResource Stat}">
                    <TextBlock Text="DPS" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Dps}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Stat}" ToolTip="Sin tiempo muerto: los huecos de más de 3 s entre golpes cuentan como 3 s">
                    <TextBlock Text="DPS ACTIVO" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding ActiveDps}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Stat}">
                    <TextBlock Text="DAÑO" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Total}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Stat}">
                    <TextBlock Text="DURACIÓN" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Duration}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Stat}" ToolTip="Daño que pasó la vida que le quedaba al objetivo">
                    <TextBlock Text="OVERKILL" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Overkill}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </StackPanel>

            <!-- Encabezado de columnas, fila TOTAL abajo y skills en el medio -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Margin="10,4,10,0" Padding="8,0,8,4">
                <ContentControl Content="{x:Null}">
                    <ContentControl.Template>
                        <ControlTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SKILL" Style="{StaticResource HeaderCell}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="DAÑO" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="3" Text="GOLPES" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="4" Text="CRÍT." Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="5" Text="ESPALDA" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="6" Text="MÁX." Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="7" Text="PROM." Style="{StaticResource HeaderCell}" ToolTip="Promedio por golpe directo (sin ticks de DoT)" />
                                <TextBlock Grid.Column="8" Text="DPS" Style="{StaticResource HeaderCell}" />
                            </Grid>
                        </ControlTemplate>
                    </ContentControl.Template>
                </ContentControl>
            </Border>

            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Margin="10,0,10,14" Padding="8,6,8,0">
                <ContentControl Content="{Binding Totals}" ContentTemplate="{StaticResource SkillRowCells}" FontWeight="Bold" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,2,10,4">
                <ItemsControl ItemsSource="{Binding Skills}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SkillRowViewModel">
                            <Grid Height="26" Margin="0,0,0,2">
                                <Rectangle Fill="{Binding DataContext.BarFill, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0.55" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Bar}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SkillRowCells}" Margin="8,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
