<Window x:Class="HysteriaMeter.App.Config.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        xmlns:conv="clr-namespace:HysteriaMeter.App.Converters"
        xmlns:update="clr-namespace:HysteriaMeter.App.Update"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MeterViewModel}"
        Title="Configuración"
        Width="1040" Height="700" MinWidth="880" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: mocks/Config.dc.html (la página Apariencia). Las otras siete secciones no tienen diseño:
         reparten las opciones que antes estaban en el panel del overlay, con los mismos controles del mock. -->
    <Window.Resources>
        <!-- Chips de FUENTE: cada nombre escrito en su propia fuente, como el mock -->
        <conv:FontPreviewConverter x:Key="FontPreview" />
        <!-- Bloque de una sección, con su etiqueta en mayúsculas ("TEMA", "FILAS") -->
        <Style x:Key="Block" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="BlockLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Aclaración debajo de un control o de un bloque -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Aviso en el color del acento; se oculta vacío -->
        <Style x:Key="Notice" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{DynamicResource Gold}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Interruptor del mock (36 × 20) con el texto y, si tiene Tag, la aclaración debajo en tenue -->
        <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            <TextBlock x:Name="HintText" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}}" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="{x:Null}">
                                <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chips de opciones: ChipList sin el ScrollViewer de la ListBox, que se comía la rueda del mouse de la página -->
        <Style x:Key="Chips" TargetType="ListBox" BasedOn="{StaticResource ChipList}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Alcance (RadioButton) con el aspecto de chip -->
        <Style x:Key="ChoiceChip" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <!-- Slider con su etiqueta arriba ("Alto de fila · 30 px"), como el mock -->
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldSlider" TargetType="Slider" BasedOn="{StaticResource AccentSlider}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Tecla de atajo editable: la caja con el aspecto de KeyCap. Con foco espera la combinación nueva. -->
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Hacé clic y apretá la combinación nueva; Borrar lo saca" />
            <EventSetter Event="PreviewKeyDown" Handler="OnHotkeyKeyDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource StrokeKbd}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}" Padding="7,3" MinWidth="44">
                            <Grid>
                                <TextBlock x:Name="Empty" Text="sin atajo" Foreground="{DynamicResource TextDim}" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                <Setter TargetName="Empty" Property="Text" Value="apretá la combinación" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HotkeyCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <!-- Nombre de la tarjeta de atajo: si igual no entra, se corta con "…" (el ToolTip de la tarjeta lo explica) -->
        <Style x:Key="HotkeyName" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- La grilla de atajos va en Apariencia (como el mock) y en Atajos: una sola plantilla para las dos. Tres columnas;
             dos si la ventana se achica (OnHotkeyGridSizeChanged). -->
        <ControlTemplate x:Key="HotkeyCards" TargetType="ContentControl">
            <UniformGrid Columns="3" Margin="0,0,-10,-10" SizeChanged="OnHotkeyGridSizeChanged">
                <UniformGrid.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource HotkeyBox}">
                        <Setter Property="DockPanel.Dock" Value="Right" />
                        <Setter Property="Margin" Value="8,0,0,0" />
                    </Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HotkeyName}" />
                </UniformGrid.Resources>
                <Border Style="{StaticResource HotkeyCard}" ToolTip="Ocultar / mostrar el overlay">
                    <DockPanel><TextBox Text="{Binding HotkeyVisibility, UpdateSourceTrigger=Explicit}" /><TextBlock Text="Mostrar / ocultar" /></DockPanel>
                </Border>
                <Border Style="{StaticResource HotkeyCard}" ToolTip="Minimizar / abrir el overlay">
                    <DockPanel><TextBox Text="{Binding HotkeyMinimize, UpdateSourceTrigger=Explicit}" /><TextBlock Text="Minimizar" /></DockPanel>
                </Border>
                <Border Style="{StaticResource HotkeyCard}" ToolTip="Pausar / seguir en vivo">
                    <DockPanel><TextBox Text="{Binding HotkeyPause, UpdateSourceTrigger=Explicit}" /><TextBlock Text="Pausar" /></DockPanel>
                </Border>
                <Border Style="{StaticResource HotkeyCard}" ToolTip="Reiniciar el encuentro">
                    <DockPanel><TextBox Text="{Binding HotkeyReset, UpdateSourceTrigger=Explicit}" /><TextBlock Text="Nueva pelea" /></DockPanel>
                </Border>
                <Border Style="{StaticResource HotkeyCard}" ToolTip="DPS → CURA → RECIB. en la ventana principal">
                    <DockPanel><TextBox Text="{Binding HotkeyTab, UpdateSourceTrigger=Explicit}" /><TextBlock Text="Cambiar pestaña" /></DockPanel>
                </Border>
                <Border Style="{StaticResource HotkeyCard}" ToolTip="Bloquear / desbloquear clics: los clics pasan al juego">
                    <DockPanel><TextBox Text="{Binding HotkeyClickThrough, UpdateSourceTrigger=Explicit}" /><TextBlock Text="Click-through" /></DockPanel>
                </Border>
                <Border Style="{StaticResource HotkeyCard}" ToolTip="Marcar este momento de la pelea">
                    <DockPanel><TextBox Text="{Binding HotkeyMark, UpdateSourceTrigger=Explicit}" /><TextBlock Text="Marcar momento" /></DockPanel>
                </Border>
            </UniformGrid>
        </ControlTemplate>

        <!-- Tarjeta de tema: vista previa con la paleta real (suelo y tres barras del acento) y el nombre -->
        <Style x:Key="ThemeCards" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Margin="0,0,-12,0" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
                        <Setter Property="ToolTip" Value="{Binding Theme.Description}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                            CornerRadius="{StaticResource RadiusCard}" Padding="10">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <!-- CSS: height 54 + padding vertical 6 + 6 = 66 de alto exterior. -->
                            <Border Height="66" CornerRadius="5" Padding="6" Background="{Binding Ground}">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="9" />
                                            <Setter Property="CornerRadius" Value="2" />
                                            <Setter Property="Margin" Value="0,0,0,3" />
                                            <Setter Property="Background" Value="{Binding Bar}" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90*" /><ColumnDefinition Width="10*" /></Grid.ColumnDefinitions>
                                        <Border />
                                    </Grid>
                                    <Grid Opacity="0.7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70*" /><ColumnDefinition Width="30*" /></Grid.ColumnDefinitions>
                                        <Border />
                                    </Grid>
                                    <Grid Opacity="0.5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="45*" /><ColumnDefinition Width="55*" /></Grid.ColumnDefinitions>
                                        <Border />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Theme.Name}" Margin="0,8,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowFrame}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navegación: el radio propio en las esquinas de la izquierda (el del marco no recorta a los hijos) -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0"
                    CornerRadius="9,0,0,9" Padding="10,18" MouseLeftButtonDown="OnHeaderMouseDown">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Configuración" Style="{StaticResource WindowTitle}" FontSize="{StaticResource NumberSizeSection}"
                               Margin="10,0,10,12" />
                    <!-- Pie: la versión en una línea (con el commit no entra junto a "captura pasiva") -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0">
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Version, Mode=OneTime, StringFormat='Hysteria Meter {0}'}"
                                   ToolTip="{Binding Version, Mode=OneTime, StringFormat='Hysteria Meter {0}'}" />
                        <TextBlock Style="{StaticResource Hint}" Text="captura pasiva" />
                    </StackPanel>
                    <StackPanel>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Apariencia" IsChecked="True" />
                        <RadioButton x:Name="NavColumns" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Columnas" />
                        <RadioButton x:Name="NavAlerts" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Alertas y sonidos" />
                        <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Atajos" />
                        <RadioButton x:Name="NavCapture" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Captura" />
                        <RadioButton x:Name="NavGameData" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Datos del juego" />
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Historial" />
                        <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" GroupName="ConfigNav" Content="Diagnóstico" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <!-- Una página por sección. Con clave: implícito también le llegaba al desplegable del ComboBox de Captura. -->
                    <Style x:Key="Page" TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="Padding" Value="28,22,28,0" />
                    </Style>
                </Grid.Resources>

                <!-- ===================== Apariencia (el mock) ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavAppearance, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="TEMA" Style="{StaticResource BlockLabel}" />
                            <ListBox Style="{StaticResource ThemeCards}" ItemsSource="{Binding ThemeCards, Mode=OneTime}"
                                     SelectedValuePath="Theme" SelectedValue="{Binding SelectedTheme}"
                                     ToolTip="Si algún color no cambia, se ve completo al reabrir el meter" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FILAS" Style="{StaticResource BlockLabel}" />
                                <TextBlock Style="{StaticResource SliderLabel}" ToolTip="Alto de cada fila; el modo compacto usa 22 px">
                                    <Run Text="Alto de fila · " /><Run Text="{Binding RowHeight, Mode=OneWay}" /><Run Text=" px" />
                                </TextBlock>
                                <Slider Style="{StaticResource FieldSlider}" Minimum="{x:Static vm:MeterViewModel.MinRowHeight}" Maximum="{x:Static vm:MeterViewModel.MaxRowHeight}"
                                        TickFrequency="2" IsSnapToTickEnabled="True" SmallChange="2" LargeChange="2"
                                        Value="{Binding RowHeight, Delay=250}" />

                                <DockPanel Margin="0,0,0,6">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" MinHeight="0" Content="Todos" IsChecked="{Binding ShowAllRows}"
                                              ToolTip="Sin máximo: se ven todos los jugadores" />
                                    <!-- "todos" va en el Run y no en TextBlock.Text: poner Text reemplaza los Runs y no vuelven al apagar "Todos" -->
                                    <TextBlock x:Name="RowLimitLabel" VerticalAlignment="Center" ToolTip="Cuántos jugadores mostrar; si quedás afuera, tu fila ocupa el último lugar">
                                        <Run Text="Máximo de jugadores · " /><Run>
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Text" Value="{Binding RowLimit, Mode=OneWay}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowAllRows}" Value="True">
                                                            <Setter Property="Text" Value="todos" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DockPanel>
                                <Slider Minimum="{x:Static vm:MeterViewModel.MinRowLimit}" Maximum="{x:Static vm:MeterViewModel.MaxRowLimit}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                        Value="{Binding RowLimit, Delay=250}">
                                    <Slider.Style>
                                        <Style TargetType="Slider" BasedOn="{StaticResource FieldSlider}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowAllRows}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>

                                <TextBlock Style="{StaticResource SliderLabel}" ToolTip="Transparencia de toda la ventana del overlay">
                                    <Run Text="Opacidad · " /><Run Text="{Binding OverlayOpacity, Mode=OneWay, StringFormat={}{0:P0}}" />
                                </TextBlock>
                                <Slider Style="{StaticResource FieldSlider}" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        SmallChange="0.05" LargeChange="0.1" Value="{Binding OverlayOpacity, Delay=250}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Opaco al pasar el mouse" IsChecked="{Binding OpaqueOnHover}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Atenuar sin combate" IsChecked="{Binding FadeWhenIdle}"
                                          Tag="Casi transparente si no hay pelea hace 20 segundos" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COLUMNAS Y OPCIONES" Style="{StaticResource BlockLabel}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Colores por clase" Tag="Barras del color de cada clase" IsChecked="{Binding ColorByClass}"
                                          ToolTip="En vez de un color por jugador. Los colores de cada clase se cambian en data/classes.json" />
                                <CheckBox Style="{StaticResource Switch}" Content="Columna TOTAL" Tag="Daño acumulado al lado del DPS" IsChecked="{Binding ShowTotalColumn}"
                                          ToolTip="Con &quot;Mostrar HPS junto al daño&quot; la columna muestra el HPS" />
                                <CheckBox Style="{StaticResource Switch}" Content="Columna %" Tag="Parte del daño del party" IsChecked="{Binding ShowShareColumn}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Solo el daño al boss" Tag="En el trash cuenta todo · solo esta ventana" IsChecked="{Binding BossOnly}"
                                          ToolTip="Contra un boss cuenta solo el daño al boss, sin adds (como Abyss). En un pull de trash se cuenta todo." />
                                <CheckBox Style="{StaticResource Switch}" Content="Item level y power" Tag="A la derecha del nombre" IsChecked="{Binding ShowGear}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Solo mi fila" Tag="Para streamear sin mostrar al resto" IsChecked="{Binding OnlyMe}"
                                          ToolTip="El overlay muestra solo tu DPS y tu puesto en la party" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="ATAJOS" Style="{StaticResource BlockLabel}" />
                            <ContentControl Template="{StaticResource HotkeyCards}" Focusable="False" />
                            <TextBlock Text="{Binding HotkeyMessage}" Style="{StaticResource Notice}" Margin="0,10,0,0" />
                        </StackPanel>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FUENTE" Style="{StaticResource BlockLabel}" />
                                <ListBox Style="{StaticResource Chips}" ItemsSource="{x:Static vm:MeterPreferences.Fonts}" SelectedItem="{Binding FontName}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding Converter={StaticResource FontPreview}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="NÚMEROS" Style="{StaticResource BlockLabel}" Margin="0,6,0,10" />
                                <ListBox Style="{StaticResource Chips}" ItemsSource="{x:Static vm:MeterViewModel.NumberStyleOptions}" SelectedItem="{Binding SelectedNumberStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Example}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Escala de la interfaz (Themes/UiScale): agranda todas las ventanas y sus popups, en vivo. -->
                                <TextBlock Text="ESCALA" Style="{StaticResource BlockLabel}" Margin="0,6,0,10" />
                                <ListBox Style="{StaticResource Chips}" ItemsSource="{x:Static vm:MeterPreferences.ScaleOptions}" SelectedItem="{Binding UiScale}"
                                         AutomationProperties.Name="Escala de la interfaz">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='{}{0:P0}'}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Texto y controles de todas las ventanas; el overlay además tiene su zoom (Ctrl + rueda)" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="VENTANA" Style="{StaticResource BlockLabel}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Modo compacto" Tag="Solo las filas y el reloj · solo esta ventana" IsChecked="{Binding IsCompact}"
                                          ToolTip="También se cambia con doble clic en el encabezado" />
                                <CheckBox Style="{StaticResource Switch}" Content="Imanes" Tag="Pegar la ventana a los bordes al soltarla" IsChecked="{Binding SnapWindows}"
                                          ToolTip="Bordes de la pantalla y de las otras ventanas del meter" />
                                <CheckBox Style="{StaticResource Switch}" Content="Fijar posición y tamaño" Tag="No se arrastra ni se agranda sin querer" IsChecked="{Binding LockPosition}"
                                          ToolTip="Los botones y las filas siguen andando" />
                                <Button Style="{StaticResource ButtonLink}" Content="Ver barras de prueba" Command="{Binding ShowDemoCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        ToolTip="Una pelea inventada para acomodar tamaño, fuente y opacidad sin combatir" />
                                <!-- Lo mismo que se aplica una vez a lo guardado antes del rediseño (OverlayWindows.Migrate): vuelve a las filas del mock después de haber prendido columnas. -->
                                <Button Style="{StaticResource ButtonLink}" Content="Volver a la vista de fábrica" Command="{Binding ResetViewCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        ToolTip="Filas como el diseño: DPS y %, colores por clase, sin línea de DPS, item level ni columnas extra, y esta ventana sin modo compacto. No toca tema, fuente, opacidad, alto de fila ni atajos" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Columnas ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavColumns, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource Block}">
                                <TextBlock Text="COLUMNAS" Style="{StaticResource BlockLabel}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Columna TOTAL" Tag="Daño acumulado al lado del DPS (o el HPS)" IsChecked="{Binding ShowTotalColumn}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Columna %" Tag="Parte del daño del party" IsChecked="{Binding ShowShareColumn}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Columna 10 s" Tag="DPS de los últimos 10 segundos" IsChecked="{Binding ShowRecentColumn}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Columna CRIT" Tag="Porcentaje de críticos" IsChecked="{Binding ShowCritColumn}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Columna MÁX" Tag="Golpe más alto" IsChecked="{Binding ShowMaxHitColumn}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Block}">
                                <TextBlock Text="EN CADA FILA" Style="{StaticResource BlockLabel}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Mostrar HPS junto al daño" Tag="Columna HPS en la pestaña de daño · solo esta ventana" IsChecked="{Binding ShowHealing}"
                                          ToolTip="Apagado: cada ventana muestra solo lo de su pestaña. Con + abrís otra ventana, por ejemplo una de curación." />
                                <CheckBox Style="{StaticResource Switch}" Content="Línea de DPS" Tag="Los últimos 30 s en cada fila" IsChecked="{Binding ShowSparklines}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Item level y power" Tag="A la derecha del nombre" IsChecked="{Binding ShowGear}" />
                                <CheckBox Style="{StaticResource Switch}" Content="Colores por clase" Tag="Barras del color de cada clase" IsChecked="{Binding ColorByClass}"
                                          ToolTip="Los colores de cada clase se cambian en data/classes.json" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="REFRESCO" Style="{StaticResource BlockLabel}" />
                            <ListBox Style="{StaticResource Chips}" ItemsSource="{x:Static vm:MeterPreferences.RefreshOptions}" SelectedItem="{Binding RefreshMs}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} ms'}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Más rápido se ve más fluido; más lento usa menos CPU" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Alertas y sonidos ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavAlerts, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="SONIDO" Style="{StaticResource BlockLabel}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Sonido en las alertas" IsChecked="{Binding Sounds}"
                                      Tag="Récord, prueba de DPS terminada y enrage al que no se llega (el enrage sale de data/npcs.json)" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="PRUEBA DE DPS (MUÑECO)" Style="{StaticResource BlockLabel}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Congela la pelea al llegar a este tiempo; reiniciá (atajo Nueva pelea) para otro intento" />
                            <ListBox Style="{StaticResource Chips}" ItemsSource="{x:Static vm:MeterPreferences.PracticeOptions}" SelectedItem="{Binding PracticeSeconds}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Label" Text="{Binding StringFormat='{}{0} s'}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="0">
                                                <Setter TargetName="Label" Property="Text" Value="Apagada" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="AL DERROTAR UN BOSS" Style="{StaticResource BlockLabel}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Guardar una imagen" IsChecked="{Binding ImageOnKill}"
                                      Tag="Un .png del overlay en Exportes, con el nombre del boss y la hora"
                                      ToolTip="Cuenta como boss lo marcado en data/npcs.json o lo que aguantó al menos 30 s" />
                            <CheckBox Style="{StaticResource Switch}" Content="Mandar a Discord" IsChecked="{Binding DiscordOnKill}" IsEnabled="{Binding IsDiscordConfigured}"
                                      Tag="Necesita el webhook de Discord (Historial)" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Atajos ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavHotkeys, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="ATAJOS GLOBALES" Style="{StaticResource BlockLabel}" />
                            <ContentControl Template="{StaticResource HotkeyCards}" Focusable="False" />
                            <TextBlock Text="{Binding HotkeyMessage}" Style="{StaticResource Notice}" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Andan aunque el juego tenga el foco. Hacé clic en una tecla y apretá la combinación nueva (Ctrl, Alt o Shift con otra tecla, o una tecla F); Borrar o Supr la saca." />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="CON EL MOUSE, SOBRE EL OVERLAY" Style="{StaticResource BlockLabel}" />
                            <UniformGrid Columns="3" Margin="0,0,-10,-10" SizeChanged="OnHotkeyGridSizeChanged">
                                <UniformGrid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HotkeyName}" />
                                </UniformGrid.Resources>
                                <Border Style="{StaticResource HotkeyCard}" ToolTip="Zoom del overlay: Ctrl + rueda del mouse">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" Margin="8,0,0,0"><TextBlock Text="Ctrl + rueda" /></Border>
                                        <TextBlock Text="Zoom" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource HotkeyCard}" ToolTip="Modo compacto: doble clic en el encabezado del overlay">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" Margin="8,0,0,0"><TextBlock Text="Doble clic arriba" /></Border>
                                        <TextBlock Text="Modo compacto" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource HotkeyCard}" ToolTip="Esc cierra la configuración o el historial; sin nada abierto, vuelve a la pelea en vivo">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" Margin="8,0,0,0"><TextBlock Text="Esc" /></Border>
                                        <TextBlock Text="Cerrar / volver al vivo" />
                                    </DockPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Captura ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavCapture, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="PLACA DE RED" Style="{StaticResource BlockLabel}" />
                            <ComboBox ItemsSource="{Binding CaptureDeviceOptions}" SelectedItem="{Binding SelectedCaptureDevice}" DisplayMemberPath="Label"
                                      HorizontalAlignment="Left" MinWidth="360" MaxWidth="560" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Se aplica al reiniciar el meter. Automática escucha todas las placas menos loopback; elegí una si tenés VPN o varias conexiones." />
                            <!-- Npcap no está instalado o no ve ninguna placa (aunque quede en la lista una guardada que no está) -->
                            <TextBlock Margin="0,6,0,0" Text="Npcap no muestra ninguna placa: revisá que esté instalado (modo compatible WinPcap).">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Notice}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNpcapDevices}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Notice}" Margin="0,6,0,0"
                                       Text="La placa elegida no está conectada: la captura usa Automática hasta que vuelva y reinicies el meter."
                                       Visibility="{Binding CaptureDeviceMissing, Converter={StaticResource Visible}}" />
                            <TextBlock Style="{StaticResource Notice}" Margin="0,6,0,0" Text="Reiniciá el meter para usar la placa elegida."
                                       Visibility="{Binding CaptureRestartPending, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="CONTAR DAÑO DE" Style="{StaticResource BlockLabel}" />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Scope" Content="Solo yo" IsChecked="{Binding ScopeMe}" />
                                <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Scope" Content="Yo y mi party" IsChecked="{Binding ScopeParty}" />
                                <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Scope" Content="Todos los jugadores cerca" IsChecked="{Binding ScopeEveryone}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Al cambiarlo se arranca de cero, para no mezclar criterios en la misma pelea" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="PELEAS" Style="{StaticResource BlockLabel}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Reiniciar en cada pelea nueva" IsChecked="{Binding SplitEncounters}"
                                      Tag="Apagado: el daño se acumula entre peleas hasta que reinicies a mano" />
                            <CheckBox Style="{StaticResource Switch}" Content="Volver al vivo cuando empieza una pelea" IsChecked="{Binding AutoBackToLive}"
                                      Tag="Si estás mirando una pelea guardada y arranca otra, el overlay vuelve solo a la actual" />
                            <TextBlock Text="Termina tras estos segundos sin daño" Margin="0,8,0,8" />
                            <ListBox Style="{StaticResource Chips}" ItemsSource="{x:Static vm:MeterPreferences.IdleOptions}" SelectedItem="{Binding IdleSeconds}"
                                     ToolTip="Más alto para bosses con fases sin daño; más bajo para separar el trash">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} s'}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="GRABACIÓN" Style="{StaticResource BlockLabel}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Grabar lo capturado (.pcap)" IsChecked="{Binding IsRecording}"
                                      Tag="Guarda el tráfico del juego para revisar una pelea. Arrancá antes de entrar a la dungeon." />
                            <StackPanel Orientation="Horizontal" Margin="48,0,0,0">
                                <TextBlock Text="{Binding RecordingHint}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ButtonLink}" Content="Abrir carpeta" Command="{Binding OpenRecordingsCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Datos del juego ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavGameData, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="CARPETA" Style="{StaticResource BlockLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonGhost}" Content="Abrir carpeta" Command="{Binding OpenGameDataCommand}" Margin="10,0,0,0" />
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="10,0" MinHeight="36">
                                    <TextBlock Text="{Binding GameData.Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameData.Folder}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" Text="La carpeta todavía no existe: las skills que no están en data/ se ven con su número y sin ícono.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Notice}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameData.Exists}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="QUÉ HAY" Style="{StaticResource BlockLabel}" />
                            <UniformGrid Columns="3" Margin="0,0,-12,0">
                                <UniformGrid.Resources>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                    </Style>
                                </UniformGrid.Resources>
                                <Border>
                                    <StackPanel>
                                        <TextBlock Text="SKILLS CON NOMBRE" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding GameData.Skills}" Style="{StaticResource NumberStrong}" FontSize="{StaticResource NumberSizeSection}" Margin="0,4,0,2" />
                                        <TextBlock Text="skills.json" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border>
                                    <StackPanel>
                                        <TextBlock Text="ÍCONOS DE SKILLS" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding GameData.Icons}" Style="{StaticResource NumberStrong}" FontSize="{StaticResource NumberSizeSection}" Margin="0,4,0,2" />
                                        <TextBlock Text="iconos\&lt;id&gt;.png" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border>
                                    <StackPanel>
                                        <TextBlock Text="EMBLEMAS DE CLASE" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding GameData.Emblems}" Style="{StaticResource NumberStrong}" FontSize="{StaticResource NumberSizeSection}" Margin="0,4,0,2" />
                                        <TextBlock Text="clases\&lt;id&gt;.png" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="DE DÓNDE SALEN" Style="{StaticResource BlockLabel}" />
                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="18"
                                       Text="Los deja hysteria-extract (tools/HysteriaMeter.Extractor), que lee los archivos de AION 2 en disco con el juego cerrado. Lo que cargues a mano en data/ les gana. Se leen al abrir el meter; nada de esto va al repo." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Historial ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavHistory, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="PELEAS GUARDADAS" Style="{StaticResource BlockLabel}" />
                            <ListBox Style="{StaticResource Chips}" ItemsSource="{x:Static vm:MeterPreferences.RetentionOptions}" SelectedItem="{Binding RetentionDays}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Label" Text="{Binding StringFormat='Borrar a los {0} días'}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="0">
                                                <Setter TargetName="Label" Property="Text" Value="Guardar todo" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Las peleas de boss derrotado y las que tienen nota no se borran nunca" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="EXPORTAR Y COMPARTIR" Style="{StaticResource BlockLabel}" />
                            <WrapPanel Margin="0,0,0,10">
                                <WrapPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonSoft}">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                    </Style>
                                </WrapPanel.Resources>
                                <Button Content="Copiar imagen" Command="{Binding CopyImageCommand}" ToolTip="Copia el overlay como imagen, para pegar en Discord" />
                                <Button Content="Guardar CSV" Command="{Binding ExportCsvCommand}" ToolTip="Una fila por jugador, para Excel o Google Sheets" />
                                <Button Content="Guardar JSON" Command="{Binding ExportJsonCommand}" ToolTip="La pelea completa, con skills y línea de tiempo" />
                                <Button Content="Abrir pelea…" Click="OnOpenFightClick"
                                        ToolTip="Abre un JSON guardado con &quot;Guardar JSON&quot; (tuyo o de otro de la legión). También podés arrastrarlo al overlay." />
                                <Button Content="Abrir carpeta" Command="{Binding OpenExportsCommand}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <WrapPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                    </Style>
                                </WrapPanel.Resources>
                                <Button Content="Exportar perfil" Command="{Binding ExportProfileCommand}"
                                        ToolTip="Guarda esta configuración (sin el webhook ni la placa de red) en Exportes\perfil-hysteria.json para otra PC o la legión" />
                                <Button Content="Cargar perfil" Command="{Binding ImportProfileCommand}"
                                        ToolTip="Carga Exportes\perfil-hysteria.json; tu webhook de Discord y tu placa de red se mantienen" />
                            </WrapPanel>
                            <CheckBox Style="{StaticResource Switch}" Content="Ocultar los nombres de los demás" IsChecked="{Binding AnonymizeExports}"
                                      Tag="En el resumen, el CSV, el JSON y Discord: vos quedás como &quot;Yo&quot; y el resto como &quot;Jugador 1&quot;, &quot;Jugador 2&quot;..." />
                            <CheckBox Style="{StaticResource Switch}" Content="Guardar una imagen al derrotar un boss" IsChecked="{Binding ImageOnKill}"
                                      Tag="Un .png del overlay en Exportes, con el nombre del boss y la hora"
                                      ToolTip="Cuenta como boss lo marcado en data/npcs.json o lo que aguantó al menos 30 s" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="DISCORD" Style="{StaticResource BlockLabel}" />
                            <TextBlock Text="Webhook de Discord (opcional)" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Configuración del canal → Integraciones → Webhooks → Copiar URL. Nada sale de tu PC si queda vacío." />
                            <DockPanel Margin="0,8,0,0" IsEnabled="{Binding IsDiscordConfigured}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonSoft}" Content="Mandar ahora" Command="{Binding SendToDiscordCommand}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                <CheckBox Style="{StaticResource Switch}" Content="Al derrotar un boss" IsChecked="{Binding DiscordOnKill}" Tag="Manda el resumen de la pelea al canal" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Diagnóstico ===================== -->
                <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding IsChecked, ElementName=NavDiagnostics, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="CAPTURA" Style="{StaticResource BlockLabel}" />
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               ToolTip="Frames: mensajes del juego leídos. Conocidos: los que el meter sabe interpretar. Resincronizaciones: huecos en la conexión. Desincronizaciones: el meter leyó un largo de mensaje inválido y descartó lo pendiente (puede pasar después de un hueco o al tomar la conexión a mitad de camino). Descartados: paquetes del juego que el meter tiró porque no daba abasto (no son pérdidas de la placa ni de Npcap). Errores, resincronizaciones o desincronizaciones altos indican un problema de lectura." />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource ButtonGhost}" Content="Reportar un problema" Command="{Binding ReportProblemCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    ToolTip="Copia la versión, el diagnóstico y la verificación (sin nombres de personajes ni de NPC) y abre un issue en GitHub para contar qué pasó" />
                        </StackPanel>
                        <!-- La verificación por objetivo de la pelea que muestra el meter (con la vista RUN o SESIÓN, la pelea en
                             curso o la última): el resumen y una línea por objetivo, que se oculta sin verificación. -->
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="VERIFICACIÓN" Style="{StaticResource BlockLabel}" />
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Verification}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VerificationDetail}" Margin="0,6,0,0" LineHeight="18">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Compara el daño contra cada objetivo con la vida que perdió según el servidor, con 1 % de tolerancia. Cuenta el de todos los jugadores (también los que el filtro deja fuera) y el de las invocaciones, aunque el meter no sepa de quién son. «No cierra» puede ser un golpe que el meter no leyó o algo del juego que cambia la vida sin daño: monstruos que mueren sin golpes o recuperan la vida, o, en algunos del mundo abierto, una escala que todavía no se explica y hace que la vida baje más que el daño." />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Block}">
                            <TextBlock Text="PROGRAMA" Style="{StaticResource BlockLabel}" />
                            <TextBlock Text="{Binding Version, Mode=OneTime}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding DataFolderHint, Mode=OneTime}" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       ToolTip="Para el modo portable, creá un archivo portable.txt junto a HysteriaMeter.exe" />
                            <CheckBox Style="{StaticResource Switch}" Content="Iniciar con Windows" IsChecked="{Binding StartWithWindows}"
                                      Tag="Abre el meter al iniciar sesión. Si movés la carpeta del programa, se corrige sola al abrirlo." />
                            <!-- Solo en el zip portable de los releases (Update/UpdateState.IsAvailable): un build local no se actualiza. -->
                            <CheckBox Style="{StaticResource Switch}" Content="Actualizar solo" IsChecked="{Binding AutoUpdate}"
                                      Visibility="{Binding Source={x:Static update:UpdateState.IsAvailable}, Converter={StaticResource Visible}}"
                                      Tag="Busca versiones nuevas en los releases de GitHub cada 6 horas y las baja; se instalan la próxima vez que abrís el meter." />
                            <TextBlock Text="{Binding Source={x:Static update:UpdateState.Current}, Path=StatusText}" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Resultado de la última acción (imagen copiada o guardada, exportes, Discord, perfil, inicio con Windows): a la
                     vista desde cualquier sección. Se oculta vacío. -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="28,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExportMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="ActionMessage" Text="{Binding ExportMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </Border>

                <Button Style="{StaticResource ButtonIcon}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                        Click="OnCloseClick" ToolTip="Cerrar (Esc)">
                    <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                          Data="M6,6 L18,18 M18,6 L6,18" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
