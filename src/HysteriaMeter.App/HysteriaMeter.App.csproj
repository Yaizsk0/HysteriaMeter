<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo para el icono de la bandeja (NotifyIcon); el resto de la app es WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HysteriaMeter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sin el using global de WinForms: chocaría con los tipos de WPF (Application, Button...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HysteriaMeter.Capture\HysteriaMeter.Capture.csproj" />
    <ProjectReference Include="..\HysteriaMeter.Protocol\HysteriaMeter.Protocol.csproj" />
    <ProjectReference Include="..\HysteriaMeter.Combat\HysteriaMeter.Combat.csproj" />
    <ProjectReference Include="..\HysteriaMeter.Storage\HysteriaMeter.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\opcodes.json" Link="data\opcodes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\skills.json" Link="data\skills.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\npcs.json" Link="data\npcs.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\classes.json" Link="data\classes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\novedades.json" Link="data\novedades.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
