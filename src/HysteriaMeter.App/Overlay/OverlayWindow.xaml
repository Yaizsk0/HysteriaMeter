<Window x:Class="HysteriaMeter.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MeterViewModel}"
        Title="Hysteria Meter"
        Width="356" Height="300" MinWidth="260" MaxWidth="900" MinHeight="150" MaxHeight="1400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{Binding Font}" FontSize="13" Opacity="{Binding EffectiveOpacity}" MouseEnter="OnMouseEnterWindow" MouseLeave="OnMouseLeaveWindow" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: mocks/Main.dc.html (aprobado por Mati el 2026-10-15). -->
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Corner" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>


        <!-- Lista de opciones como chips (fuente, opacidad) -->
        <Style x:Key="Chips" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chip" Margin="0,0,6,6" Padding="8,3" BorderBrush="{StaticResource RowBorder}" BorderThickness="1" Background="{StaticResource Row}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Gold}" />
                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <!-- Casilla y opción con el estilo del overlay; sirve para CheckBox y RadioButton. -->
        <Style x:Key="Option" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="Box" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Background="{StaticResource Row}" />
                                <Border x:Name="Mark" Margin="3" Background="{StaticResource Gold}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margen para que entren las esquinas doradas, que sobresalen 2 px del marco. -->
    <!-- Ctrl + rueda del mouse cambia el zoom (escala de todo el overlay). -->
    <Grid Margin="2" PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" CornerRadius="2">
            <DockPanel>
                <!-- Encabezado: se arrastra la ventana desde acá -->
                <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll">
                    <DockPanel.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#24C9A25A" Offset="0" />
                            <GradientStop Color="#00C9A25A" Offset="1" />
                        </LinearGradientBrush>
                    </DockPanel.Background>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource Rule}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,6,6,6">
                        <Button Style="{StaticResource IconButton}" Click="OnLockClick" ToolTip="Bloquear overlay (Ctrl+Shift+L para desbloquear)">
                            <Path Style="{StaticResource Icon}" Data="M5,11 H19 V21 H5 Z M8,11 V7 A4,4 0 0 1 16,7 V11" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ResetCommand}" ToolTip="Reiniciar encuentro">
                            <Path Style="{StaticResource Icon}" Data="M3,12 A9,9 0 1 0 6,5.3 L3,8 M3,3 V8 H8" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NewWindowCommand}" ToolTip="Nueva ventana (por ejemplo, una de curación al lado de la de daño)">
                            <Path Style="{StaticResource Icon}" Data="M12,5 V19 M5,12 H19" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding CopySummaryCommand}" ToolTip="Copiar resumen (para pegar en el chat)">
                            <Path Style="{StaticResource Icon}" Data="M9,9 H20 V20 H9 Z M5,15 H4 V4 H15 V5" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleHistoryCommand}" ToolTip="Historial de peleas">
                            <Path Style="{StaticResource Icon}" Data="M12,3 A9,9 0 1 1 3,12 M3,12 A9,9 0 0 1 12,3 M12,7 V12 L15.5,14" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSettingsCommand}" ToolTip="Configuración">
                            <Path Style="{StaticResource Icon}" Data="M12,9 A3,3 0 1 0 12.01,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnCloseClick" ToolTip="Cerrar">
                            <Path Style="{StaticResource Icon}" Data="M6,6 L18,18 M18,6 L6,18" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,6,0,6" VerticalAlignment="Center">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Gold}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M12,2 L20,7 V17 L12,22 L4,17 V7 Z M12,7 V17 M8,9.5 L16,14.5 M16,9.5 L8,14.5" />
                        <TextBlock Text="HYSTERIA" Margin="8,0,0,0" FontFamily="{StaticResource TitleFont}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Gold}" VerticalAlignment="Center" ToolTip="{Binding Version}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <!-- Grabando a .pcap -->
                        <TextBlock Text="● REC" FontSize="10" FontWeight="Bold" Foreground="#E0524A" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsRecording, Converter={StaticResource Visible}}" ToolTip="{Binding RecordingHint}" />
                        <!-- Verde mientras hay combate; gris con el último encuentro terminado. -->
                        <!-- Rojo si se cortó la captura y ámbar si no llega tráfico del juego. -->
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#5C6774" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="live">
                                            <Setter Property="Fill" Value="#4CD964" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                            <Setter Property="Fill" Value="#E0A84A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                            <Setter Property="Fill" Value="#E0524A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Elapsed}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- Mirando un encuentro guardado -->
                <Border DockPanel.Dock="Top" Background="#1FC9A25A" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,0,0,1" Padding="10,3"
                        Visibility="{Binding IsViewingHistory, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Volver al vivo" Command="{Binding BackToLiveCommand}" Cursor="Hand"
                                Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="11" Padding="4,0" />
                        <TextBlock Text="{Binding HistoryLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Objetivo principal -->
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <!-- Vida del objetivo principal, como en el mock: "6.11M / 9.86M · 62%" y una barra fina debajo -->
                    <Grid DockPanel.Dock="Bottom" Height="4" Margin="0,5,0,0" Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}">
                        <Border Background="{StaticResource HealthTrack}" BorderBrush="{StaticResource HealthTrackBorder}" BorderThickness="1" />
                        <Border Background="{StaticResource Health}" Margin="1" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding TargetHealthRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TargetHealthText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextBright}" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- Pestañas -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,0,0,1" Padding="10,0" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Tab}" GroupName="MeterTab" Content="DAÑO" IsChecked="{Binding IsDamageTab}" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="MeterTab" Content="CURACIÓN" IsChecked="{Binding IsHealingTab}" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="MeterTab" Content="RECIBIDO" IsEnabled="False"
                                         ToolTip="Próximamente: falta decodificar el daño que reciben los jugadores" ToolTipService.ShowOnDisabled="True" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Pie -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,1,0,0" Padding="10,6,18,6" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <DockPanel TextElement.FontSize="12" TextElement.Foreground="{StaticResource TextDim}">
                        <TextBlock DockPanel.Dock="Right">
                            <Run Text="Crít." />
                            <Run Text="{Binding CritRate, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Text}" />
                            <Run Text="· Máx." />
                            <Run Text="{Binding MaxHit, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Text}" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Party" />
                            <Run Text="{Binding PartyPerSecond, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Text}" />
                            <Run Text="{Binding RateUnit, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding PartyTotal, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Encabezado de columnas, alineado con las filas (margen 6 + borde 1 + 8) -->
                <Grid DockPanel.Dock="Top" Margin="15,5,15,0" TextElement.FontSize="11" TextElement.Foreground="{StaticResource TextDim}" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="JUGADOR" />
                    <TextBlock Grid.Column="2" Text="{Binding RateUnit}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding SecondColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="%" HorizontalAlignment="Right" />
                </Grid>

                <!-- Filas: ocupan el resto del alto; si no entran, se desplazan con la rueda. -->
                <Grid>
                <TextBlock Text="{Binding EmptyText}" Margin="10,10" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="{StaticResource TextDim}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Actors}" Margin="6,3,6,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ActorRowViewModel">
                            <Border x:Name="Row" Height="30" Margin="0,0,0,3" Background="{StaticResource Row}" BorderBrush="{StaticResource RowBorder}" BorderThickness="1"
                                    ToolTip="{Binding Breakdown}" Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                                <Grid>
                                    <!-- Barra proporcional al primero -->
                                    <Rectangle x:Name="Bar" Fill="{Binding BarFill}" HorizontalAlignment="Stretch">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Bar}" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                        <!-- Rombo de clase: por ahora la inicial; el color de clase llega cuando decodifiquemos la clase. -->
                                        <Grid Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Left">
                                            <Border x:Name="Diamond" Width="14" Height="14" BorderBrush="{Binding Accent}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="45" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <TextBlock x:Name="InitialText" Text="{Binding Initial}" FontSize="11" FontWeight="Bold" Foreground="{Binding Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="NameText" Grid.Column="2" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="PerSecondText" Grid.Column="3" Text="{Binding PerSecond}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBright}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <!-- Total, o HPS cuando daño y curación van juntos -->
                                        <TextBlock x:Name="TotalText" Grid.Column="4" Text="{Binding Total}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Share}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ShowHealingColumn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="TotalText" Property="Text" Value="{Binding HealingPerSecond}" />
                                    <Setter TargetName="TotalText" Property="Foreground" Value="{StaticResource Healing}" />
                                </DataTrigger>
                                <!-- Compacto: filas más bajas para que entren más jugadores -->
                                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="Row" Property="Height" Value="22" />
                                    <Setter TargetName="Row" Property="Margin" Value="0,0,0,2" />
                                    <Setter TargetName="NameText" Property="FontSize" Value="13" />
                                    <Setter TargetName="PerSecondText" Property="FontSize" Value="13" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource RowBorderLocal}" />
                                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource NameLocal}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- Historial: tapa las filas mientras está abierto; clic en un encuentro lo muestra en el overlay -->
                <Border Background="{StaticResource PanelSolid}" Visibility="{Binding IsHistoryOpen, Converter={StaticResource Visible}}">
                    <DockPanel Margin="12,10">
                        <TextBlock DockPanel.Dock="Top" Text="PELEAS GUARDADAS" Style="{StaticResource SettingsHeader}" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:HistoryItem">
                                        <Button Command="{Binding DataContext.OpenEncounterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,3" HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Frame" Background="{StaticResource Row}" BorderBrush="{StaticResource RowBorder}" BorderThickness="1" Padding="8,4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold" Foreground="{StaticResource TextBright}" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Target}" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextDim}">
                                                        <Run Text="{Binding When, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Duration, Mode=OneWay}" />
                                                        <Run Text="{Binding Result, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Configuración: tapa las filas mientras está abierta -->
                <Border Background="{StaticResource PanelSolid}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource Visible}}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="12,10">
                            <TextBlock Text="CONTAR DAÑO DE" Style="{StaticResource SettingsHeader}" />
                            <RadioButton Style="{StaticResource Option}" GroupName="Scope" Content="Solo yo" IsChecked="{Binding ScopeMe}" />
                            <RadioButton Style="{StaticResource Option}" GroupName="Scope" Content="Yo y mi party" IsChecked="{Binding ScopeParty}" />
                            <RadioButton Style="{StaticResource Option}" GroupName="Scope" Content="Todos los jugadores cerca" IsChecked="{Binding ScopeEveryone}" />

                            <TextBlock Text="PELEAS" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Reiniciar en cada pelea nueva" IsChecked="{Binding SplitEncounters}"
                                      ToolTip="Apagado: el daño se acumula entre peleas hasta que reinicies a mano" />

                            <TextBlock Text="GRABACIÓN" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Grabar lo capturado (.pcap)" IsChecked="{Binding IsRecording}"
                                      ToolTip="Guarda el tráfico del juego para revisar una pelea. Arrancá antes de entrar a la dungeon." />
                            <DockPanel Margin="0,2,0,0">
                                <Button DockPanel.Dock="Right" Content="Abrir carpeta" Command="{Binding OpenRecordingsCommand}" Cursor="Hand"
                                        Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="11" Padding="4,0" />
                                <TextBlock Text="{Binding RecordingHint}" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="ESTA VENTANA" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Mostrar HPS junto al daño" IsChecked="{Binding ShowHealing}"
                                      ToolTip="Apagado: cada ventana muestra solo lo de su pestaña. Con + abrís otra ventana, por ejemplo una de curación." />
                            <CheckBox Style="{StaticResource Option}" Content="Modo compacto" IsChecked="{Binding IsCompact}"
                                      ToolTip="Solo las filas y el reloj. También se cambia con doble clic en el encabezado." />

                            <TextBlock Text="FUENTE" Style="{StaticResource SettingsHeader}" />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.Fonts}" SelectedItem="{Binding FontName}" Style="{StaticResource Chips}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="OPACIDAD" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Opaco al pasar el mouse" IsChecked="{Binding OpaqueOnHover}" />
                            <CheckBox Style="{StaticResource Option}" Content="Atenuar sin combate" IsChecked="{Binding FadeWhenIdle}"
                                      ToolTip="Casi transparente si no hay pelea hace 20 segundos; vuelve solo al empezar a pegar." />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.Opacities}" SelectedItem="{Binding OverlayOpacity}" Style="{StaticResource Chips}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0:P0}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="PRUEBA" Style="{StaticResource SettingsHeader}" />
                            <Button Content="Ver barras de prueba" Command="{Binding ShowDemoCommand}" Cursor="Hand" HorizontalAlignment="Left"
                                    Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="12" Padding="0,2"
                                    ToolTip="Una pelea inventada para acomodar tamaño, fuente y opacidad sin combatir" />

                            <TextBlock Text="ATAJOS" Style="{StaticResource SettingsHeader}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" LineHeight="18">
                                <Run Text="Ctrl+Shift+L" Foreground="{StaticResource Text}" /><Run Text="  bloquear / desbloquear clics" /><LineBreak />
                                <Run Text="Ctrl+Shift+R" Foreground="{StaticResource Text}" /><Run Text="  reiniciar el encuentro" /><LineBreak />
                                <Run Text="Ctrl+Shift+H" Foreground="{StaticResource Text}" /><Run Text="  ocultar / mostrar el overlay" /><LineBreak />
                                <Run Text="Ctrl+rueda" Foreground="{StaticResource Text}" /><Run Text="  zoom" /><LineBreak />
                                <Run Text="Doble clic arriba" Foreground="{StaticResource Text}" /><Run Text="  modo compacto" />
                            </TextBlock>

                            <TextBlock Text="VERSIÓN" Style="{StaticResource SettingsHeader}" />
                            <TextBlock Text="{Binding Version, Mode=OneTime}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>

            </DockPanel>
        </Border>

        <!-- Agarradera para cambiar ancho y alto. -->
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="0,0,1,1"
               Cursor="SizeNWSE" DragDelta="OnResizeDragDelta" ToolTip="Arrastrá para cambiar el tamaño · Ctrl + rueda para el zoom">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M13,3 L3,13 M13,8 L8,13 M13,12 L12,13" Stroke="{StaticResource GoldDim}" StrokeThickness="1.2" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- Esquinas doradas -->
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0" BorderThickness="2,2,0,0" />
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" BorderThickness="0,2,2,0" />
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-2,0,0,-2" BorderThickness="2,0,0,2" />
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" BorderThickness="0,0,2,2" />
    </Grid>
</Window>
