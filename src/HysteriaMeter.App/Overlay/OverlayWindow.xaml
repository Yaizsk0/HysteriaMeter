<Window x:Class="HysteriaMeter.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MeterViewModel}"
        Title="Hysteria Meter"
        Width="356" Height="300" MinWidth="260" MaxWidth="900" MinHeight="150" MaxHeight="1400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{Binding Font}" FontSize="13" Opacity="{Binding EffectiveOpacity}" MouseEnter="OnMouseEnterWindow" MouseLeave="OnMouseLeaveWindow" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: mocks/Main.dc.html (aprobado por Mati el 2026-10-15). -->
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Corner" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>


        <!-- Lista de opciones como chips (fuente, opacidad) -->
        <Style x:Key="Chips" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chip" Margin="0,0,6,6" Padding="8,3" BorderBrush="{StaticResource RowBorder}" BorderThickness="1" Background="{StaticResource Row}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Gold}" />
                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cuadros de texto del overlay: búsqueda del historial y nota de la pelea. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SettingsHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <!-- Casilla y opción con el estilo del overlay; sirve para CheckBox y RadioButton. -->
        <Style x:Key="Option" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="Box" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Background="{StaticResource Row}" />
                                <Border x:Name="Mark" Margin="3" Background="{StaticResource Gold}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margen para que entren las esquinas doradas, que sobresalen 2 px del marco. -->
    <!-- Ctrl + rueda del mouse cambia el zoom (escala de todo el overlay). -->
    <Grid x:Name="Root" Margin="2" PreviewMouseWheel="OnPreviewMouseWheel" AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" CornerRadius="2">
            <DockPanel>
                <!-- Encabezado: se arrastra la ventana desde acá -->
                <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll">
                    <DockPanel.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#24C9A25A" Offset="0" />
                            <GradientStop Color="#00C9A25A" Offset="1" />
                        </LinearGradientBrush>
                    </DockPanel.Background>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource Rule}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,6,6,6">
                        <Button Style="{StaticResource IconButton}" Click="OnLockClick" ToolTip="Bloquear overlay (Ctrl+Shift+L para desbloquear)">
                            <Path Style="{StaticResource Icon}" Data="M5,11 H19 V21 H5 Z M8,11 V7 A4,4 0 0 1 16,7 V11" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ResetCommand}" ToolTip="Reiniciar encuentro">
                            <Path Style="{StaticResource Icon}" Data="M3,12 A9,9 0 1 0 6,5.3 L3,8 M3,3 V8 H8" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NewWindowCommand}" ToolTip="Nueva ventana (por ejemplo, una de curación al lado de la de daño)">
                            <Path Style="{StaticResource Icon}" Data="M12,5 V19 M5,12 H19" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding CopySummaryCommand}" ToolTip="Copiar resumen (para pegar en el chat)">
                            <Path Style="{StaticResource Icon}" Data="M9,9 H20 V20 H9 Z M5,15 H4 V4 H15 V5" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleHistoryCommand}" ToolTip="Historial de peleas">
                            <Path Style="{StaticResource Icon}" Data="M12,3 A9,9 0 1 1 3,12 M3,12 A9,9 0 0 1 12,3 M12,7 V12 L15.5,14" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSettingsCommand}" ToolTip="Configuración">
                            <Path Style="{StaticResource Icon}" Data="M12,9 A3,3 0 1 0 12.01,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnCloseClick" ToolTip="Cerrar">
                            <Path Style="{StaticResource Icon}" Data="M6,6 L18,18 M18,6 L6,18" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,6,0,6" VerticalAlignment="Center">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Gold}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M12,2 L20,7 V17 L12,22 L4,17 V7 Z M12,7 V17 M8,9.5 L16,14.5 M16,9.5 L8,14.5" />
                        <TextBlock Text="HYSTERIA" Margin="8,0,0,0" FontFamily="{StaticResource TitleFont}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Gold}" VerticalAlignment="Center" ToolTip="{Binding Version}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <!-- Grabando a .pcap -->
                        <TextBlock Text="● REC" FontSize="10" FontWeight="Bold" Foreground="#E0524A" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsRecording, Converter={StaticResource Visible}}" ToolTip="{Binding RecordingHint}" />
                        <!-- Verde mientras hay combate; gris con el último encuentro terminado. -->
                        <!-- Rojo si se cortó la captura y ámbar si no llega tráfico del juego. -->
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#5C6774" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="live">
                                            <Setter Property="Fill" Value="#4CD964" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                            <Setter Property="Fill" Value="#E0A84A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                            <Setter Property="Fill" Value="#E0524A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Elapsed}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- Récord personal al terminar una pelea -->
                <Border DockPanel.Dock="Top" Background="#33C9A25A" BorderBrush="{StaticResource GoldDim}" BorderThickness="0,0,0,1" Padding="10,4"
                        Visibility="{Binding HasRecordMessage, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding RecordMessage}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Gold}" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Mirando un encuentro guardado -->
                <Border DockPanel.Dock="Top" Background="#1FC9A25A" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,0,0,1" Padding="10,3"
                        Visibility="{Binding IsViewingHistory, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <!-- Nota de la pelea guardada: se guarda al salir del cuadro (o con Enter) -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,3,0,1" Visibility="{Binding CanEditNote, Converter={StaticResource Visible}}">
                            <Button DockPanel.Dock="Right" Content="Borrar pelea" Command="{Binding DeleteEncounterCommand}" Cursor="Hand"
                                    Foreground="#E0524A" Background="Transparent" BorderThickness="0" FontSize="11" Padding="6,0,0,0" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding CurrentNote, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnNoteLostFocus" KeyDown="OnNoteKeyDown"
                                     ToolTip="Nota de esta pelea (por ejemplo: rotación nueva, con piedra X). Se puede buscar en el historial." />
                        </DockPanel>
                        <Button DockPanel.Dock="Right" Content="Volver al vivo" Command="{Binding BackToLiveCommand}" Cursor="Hand"
                                Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="11" Padding="4,0" />
                        <TextBlock Text="{Binding HistoryLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Objetivo principal -->
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <!-- Vida del objetivo principal, como en el mock: "6.11M / 9.86M · 62%" y una barra fina debajo -->
                    <Grid DockPanel.Dock="Bottom" Height="4" Margin="0,5,0,0" Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}">
                        <Border Background="{StaticResource HealthTrack}" BorderBrush="{StaticResource HealthTrackBorder}" BorderThickness="1" />
                        <Border Background="{StaticResource Health}" Margin="1" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding TargetHealthRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TargetHealthText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding TargetHealthCheck}"
                               Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Style.Triggers>
                                    <!-- Al ritmo actual el boss muere después del enrage -->
                                    <DataTrigger Binding="{Binding IsEnrageDanger}" Value="True">
                                        <Setter Property="Foreground" Value="#FFE0605A" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextBright}" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- Pestañas -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,0,0,1" Padding="10,0" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <!-- Segmento: la pelea actual o la sesión entera (como Current/Overall de Details!) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" TextElement.FontSize="11">
                            <RadioButton Style="{StaticResource Tab}" GroupName="Segment" Content="PELEA" IsChecked="{Binding IsFightView}"
                                         ToolTip="La pelea actual (o la última que terminó)" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="Segment" Content="SESIÓN" IsChecked="{Binding IsSessionChip}"
                                         ToolTip="Todas las peleas desde el último reinicio, con el DPS sobre el tiempo en combate" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Tab}" GroupName="MeterTab" Content="DAÑO" IsChecked="{Binding IsDamageTab}" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="MeterTab" Content="CURACIÓN" IsChecked="{Binding IsHealingTab}" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="MeterTab" Content="RECIBIDO" IsChecked="{Binding IsTakenTab}"
                                         ToolTip="Daño que le hicieron los monstruos a cada uno (sin validar contra Combat Analysis todavía)" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Pie -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,1,0,0" Padding="10,6,18,6" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <DockPanel TextElement.FontSize="12" TextElement.Foreground="{StaticResource TextDim}">
                        <TextBlock DockPanel.Dock="Right">
                            <Run Text="Crít." />
                            <Run Text="{Binding CritRate, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Text}" />
                            <Run Text="· Máx." />
                            <Run Text="{Binding MaxHit, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Text}" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Party" />
                            <Run Text="{Binding PartyPerSecond, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Text}" />
                            <Run Text="{Binding RateUnit, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding PartyTotal, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Encabezado de columnas, alineado con las filas (margen 6 + borde 1 + 8) -->
                <Grid DockPanel.Dock="Top" Margin="15,5,15,0" TextElement.FontSize="11" TextElement.Foreground="{StaticResource TextDim}" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="JUGADOR" />
                    <TextBlock Grid.Column="2" Text="{Binding RateUnit}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding SecondColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="%" HorizontalAlignment="Right" />
                </Grid>

                <!-- Filas: ocupan el resto del alto; si no entran, se desplazan con la rueda. -->
                <Grid>
                <TextBlock Text="{Binding EmptyText}" Margin="10,10" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="{StaticResource TextDim}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Actors}" Margin="6,3,6,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ActorRowViewModel">
                            <Border x:Name="Row" Height="30" Margin="0,0,0,3" Background="{StaticResource Row}" BorderBrush="{StaticResource RowBorder}" BorderThickness="1"
                                    ToolTip="{Binding Breakdown}" Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                                <Grid>
                                    <!-- Barra proporcional al primero -->
                                    <Rectangle x:Name="Bar" Fill="{Binding BarFill}" HorizontalAlignment="Stretch">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Bar}" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <!-- DPS de los últimos 30 s, tenue detrás del texto -->
                                    <Polyline Points="{Binding Spark}" Stretch="Fill" Stroke="{Binding Accent}" StrokeThickness="1" Opacity="0.35"
                                              Margin="0,5" IsHitTestVisible="False" />
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                        <!-- Rombo de clase: por ahora la inicial; el color de clase llega cuando decodifiquemos la clase. -->
                                        <Grid Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Left">
                                            <Border x:Name="Diamond" Width="14" Height="14" BorderBrush="{Binding Accent}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="45" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <TextBlock x:Name="InitialText" Text="{Binding Initial}" FontSize="11" FontWeight="Bold" Foreground="{Binding Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- Símbolo de la clase (deducida por sus skills); tapa la inicial cuando se sabe -->
                                            <Path Data="{Binding ClassIcon}" Fill="{Binding Accent}" Width="10" Height="10" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ClassName}"
                                                  Visibility="{Binding HasClassIcon, Converter={StaticResource Visible}}" />
                                        </Grid>
                                        <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Gear}" FontSize="11" Margin="6,0,4,0" Foreground="{StaticResource TextDim}"
                                                       VerticalAlignment="Center" ToolTip="Item level · power"
                                                       Visibility="{Binding HasGear, Converter={StaticResource Visible}}" />
                                            <TextBlock x:Name="NameText" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock x:Name="PerSecondText" Grid.Column="3" Text="{Binding PerSecond}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBright}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <!-- Total, o HPS cuando daño y curación van juntos -->
                                        <TextBlock x:Name="TotalText" Grid.Column="4" Text="{Binding Total}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Share}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ShowHealingColumn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="TotalText" Property="Text" Value="{Binding HealingPerSecond}" />
                                    <Setter TargetName="TotalText" Property="Foreground" Value="{StaticResource Healing}" />
                                </DataTrigger>
                                <!-- Compacto: filas más bajas para que entren más jugadores -->
                                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="Row" Property="Height" Value="22" />
                                    <Setter TargetName="Row" Property="Margin" Value="0,0,0,2" />
                                    <Setter TargetName="NameText" Property="FontSize" Value="13" />
                                    <Setter TargetName="PerSecondText" Property="FontSize" Value="13" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasClassIcon}" Value="True">
                                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource RowBorderLocal}" />
                                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource NameLocal}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- Historial: tapa las filas mientras está abierto; clic en un encuentro lo muestra en el overlay -->
                <Border Background="{StaticResource PanelSolid}" Visibility="{Binding IsHistoryOpen, Converter={StaticResource Visible}}">
                    <DockPanel Margin="12,10">
                        <TextBlock DockPanel.Dock="Top" Text="PELEAS GUARDADAS" Style="{StaticResource SettingsHeader}" Margin="0,0,0,6" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Option}" Content="Derrotados" IsChecked="{Binding OnlyKills}" Margin="8,0,0,0" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por boss o por nota" />
                        </DockPanel>
                        <!-- Progreso de mi DPS cuando la búsqueda deja un solo boss -->
                        <Border DockPanel.Dock="Top" Height="54" Margin="0,0,0,6" Background="{StaticResource Row}" BorderBrush="{StaticResource RowBorder}" BorderThickness="1"
                                Visibility="{Binding HasProgress, Converter={StaticResource Visible}}">
                            <Grid>
                                <Polyline Points="{Binding ProgressPoints}" Stretch="Fill" Margin="6,18,6,5" Stroke="{StaticResource Gold}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                <TextBlock Text="{Binding ProgressText}" Margin="6,2,6,0" FontSize="10" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:HistoryItem">
                                        <StackPanel>
                                        <TextBlock Text="{Binding RunHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,6,0,3"
                                                   Visibility="{Binding HasRunHeader, Converter={StaticResource Visible}}" />
                                        <Button Command="{Binding DataContext.OpenEncounterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,3" HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Frame" Background="{StaticResource Row}" BorderBrush="{StaticResource RowBorder}" BorderThickness="1" Padding="8,4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Total}" FontWeight="SemiBold" Foreground="{StaticResource TextBright}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding MyDps}" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis">
                                                        <Run Foreground="{StaticResource Gold}">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Setter Property="Text" Value="" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRecord}" Value="True">
                                                                            <Setter Property="Text" Value="★ " />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run><Run Text="{Binding Target, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextDim}">
                                                        <Run Text="{Binding When, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Duration, Mode=OneWay}" />
                                                        <Run Text="{Binding Result, Mode=OneWay}" />
                                                        <Run Text="{Binding AttemptText, Mode=OneWay}" />
                                                        <Run Text="{Binding VsBest, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Note}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Configuración: tapa las filas mientras está abierta -->
                <Border Background="{StaticResource PanelSolid}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource Visible}}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="12,10">
                            <TextBlock Text="CONTAR DAÑO DE" Style="{StaticResource SettingsHeader}" />
                            <RadioButton Style="{StaticResource Option}" GroupName="Scope" Content="Solo yo" IsChecked="{Binding ScopeMe}" />
                            <RadioButton Style="{StaticResource Option}" GroupName="Scope" Content="Yo y mi party" IsChecked="{Binding ScopeParty}" />
                            <RadioButton Style="{StaticResource Option}" GroupName="Scope" Content="Todos los jugadores cerca" IsChecked="{Binding ScopeEveryone}" />

                            <TextBlock Text="PELEAS" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Reiniciar en cada pelea nueva" IsChecked="{Binding SplitEncounters}"
                                      ToolTip="Apagado: el daño se acumula entre peleas hasta que reinicies a mano" />
                            <TextBlock Text="Termina tras estos segundos sin daño" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,4,0,2" />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.IdleOptions}" SelectedItem="{Binding IdleSeconds}" Style="{StaticResource Chips}"
                                     ToolTip="Más alto para bosses con fases sin daño; más bajo para separar el trash">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} s'}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox Style="{StaticResource Option}" Content="Volver al vivo cuando empieza una pelea" IsChecked="{Binding AutoBackToLive}"
                                      ToolTip="Si estás mirando una pelea guardada y arranca otra, el overlay vuelve solo a la actual" />

                            <TextBlock Text="PRUEBA DE DPS (MUÑECO)" Style="{StaticResource SettingsHeader}" />
                            <TextBlock Text="Congela la pelea al llegar a este tiempo; reiniciá (Ctrl+Shift+R) para otro intento" FontSize="11" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,0,0,2" />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.PracticeOptions}" SelectedItem="{Binding PracticeSeconds}" Style="{StaticResource Chips}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StringFormat='{}{0} s'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="0">
                                                            <Setter Property="Text" Value="Apagada" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="GRABACIÓN" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Grabar lo capturado (.pcap)" IsChecked="{Binding IsRecording}"
                                      ToolTip="Guarda el tráfico del juego para revisar una pelea. Arrancá antes de entrar a la dungeon." />
                            <DockPanel Margin="0,2,0,0">
                                <Button DockPanel.Dock="Right" Content="Abrir carpeta" Command="{Binding OpenRecordingsCommand}" Cursor="Hand"
                                        Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="11" Padding="4,0" />
                                <TextBlock Text="{Binding RecordingHint}" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="ESTA VENTANA" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Mostrar HPS junto al daño" IsChecked="{Binding ShowHealing}"
                                      ToolTip="Apagado: cada ventana muestra solo lo de su pestaña. Con + abrís otra ventana, por ejemplo una de curación." />
                            <CheckBox Style="{StaticResource Option}" Content="Solo el daño al boss" IsChecked="{Binding BossOnly}"
                                      ToolTip="Cuenta solo el daño al objetivo principal, sin adds ni trash" />
                            <CheckBox Style="{StaticResource Option}" Content="Modo compacto" IsChecked="{Binding IsCompact}"
                                      ToolTip="Solo las filas y el reloj. También se cambia con doble clic en el encabezado." />

                            <TextBlock Text="FUENTE" Style="{StaticResource SettingsHeader}" />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.Fonts}" SelectedItem="{Binding FontName}" Style="{StaticResource Chips}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="NÚMEROS" Style="{StaticResource SettingsHeader}" />
                            <ListBox ItemsSource="{x:Static vm:MeterViewModel.NumberStyleOptions}" SelectedItem="{Binding SelectedNumberStyle}" Style="{StaticResource Chips}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Example}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox Style="{StaticResource Option}" Content="Línea de DPS de los últimos 30 s en cada fila" IsChecked="{Binding ShowSparklines}" />
                            <CheckBox Style="{StaticResource Option}" Content="Item level y power al lado del nombre" IsChecked="{Binding ShowGear}" />
                            <CheckBox Style="{StaticResource Option}" Content="Sonido en las alertas" IsChecked="{Binding Sounds}"
                                      ToolTip="Récord, prueba de DPS terminada y enrage al que no se llega (el enrage sale de data/npcs.json)" />

                            <TextBlock Text="REFRESCO" Style="{StaticResource SettingsHeader}" />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.RefreshOptions}" SelectedItem="{Binding RefreshMs}" Style="{StaticResource Chips}"
                                     ToolTip="Más rápido se ve más fluido; más lento usa menos CPU">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} ms'}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="OPACIDAD" Style="{StaticResource SettingsHeader}" />
                            <CheckBox Style="{StaticResource Option}" Content="Opaco al pasar el mouse" IsChecked="{Binding OpaqueOnHover}" />
                            <CheckBox Style="{StaticResource Option}" Content="Atenuar sin combate" IsChecked="{Binding FadeWhenIdle}"
                                      ToolTip="Casi transparente si no hay pelea hace 20 segundos; vuelve solo al empezar a pegar." />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.Opacities}" SelectedItem="{Binding OverlayOpacity}" Style="{StaticResource Chips}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0:P0}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="HISTORIAL" Style="{StaticResource SettingsHeader}" />
                            <ListBox ItemsSource="{x:Static vm:MeterPreferences.RetentionOptions}" SelectedItem="{Binding RetentionDays}" Style="{StaticResource Chips}"
                                     ToolTip="Las peleas de boss derrotado y las que tienen nota no se borran nunca">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StringFormat='Borrar a los {0} días'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="0">
                                                            <Setter Property="Text" Value="Guardar todo" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="EXPORTAR Y COMPARTIR" Style="{StaticResource SettingsHeader}" />
                            <WrapPanel>
                                <WrapPanel.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="0,2,12,2" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                </WrapPanel.Resources>
                                <Button Content="Copiar imagen" Command="{Binding CopyImageCommand}" ToolTip="Copia el overlay como imagen, para pegar en Discord" />
                                <Button Content="Guardar CSV" Command="{Binding ExportCsvCommand}" ToolTip="Una fila por jugador, para Excel o Google Sheets" />
                                <Button Content="Guardar JSON" Command="{Binding ExportJsonCommand}" ToolTip="La pelea completa, con skills y línea de tiempo" />
                                <Button Content="Abrir carpeta" Command="{Binding OpenExportsCommand}" />
                                <Button Content="Abrir pelea…" Click="OnOpenFightClick"
                                        ToolTip="Abre un JSON guardado con &quot;Guardar JSON&quot; (tuyo o de otro de la legión). También podés arrastrarlo al overlay." />
                                <Button Content="Exportar perfil" Command="{Binding ExportProfileCommand}"
                                        ToolTip="Guarda esta configuración (sin el webhook) en Exportes\perfil-hysteria.json para otra PC o la legión" />
                                <Button Content="Cargar perfil" Command="{Binding ImportProfileCommand}"
                                        ToolTip="Carga Exportes\perfil-hysteria.json; tu webhook de Discord se mantiene" />
                            </WrapPanel>
                            <CheckBox Style="{StaticResource Option}" Content="Ocultar los nombres de los demás" IsChecked="{Binding AnonymizeExports}"
                                      ToolTip="En el resumen, el CSV, el JSON y Discord: vos quedás como &quot;Yo&quot; y el resto como &quot;Jugador 1&quot;, &quot;Jugador 2&quot;..." />
                            <TextBlock Text="Webhook de Discord (opcional)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,6,0,2" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Configuración del canal → Integraciones → Webhooks → Copiar URL. Nada sale de tu PC si queda vacío." />
                            <DockPanel Margin="0,2,0,0" IsEnabled="{Binding IsDiscordConfigured}">
                                <Button DockPanel.Dock="Right" Content="Mandar ahora" Command="{Binding SendToDiscordCommand}" Cursor="Hand"
                                        Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="12" Padding="4,0" />
                                <CheckBox Style="{StaticResource Option}" Content="Al derrotar un boss" IsChecked="{Binding DiscordOnKill}" />
                            </DockPanel>
                            <TextBlock Text="{Binding ExportMessage}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <TextBlock Text="PRUEBA" Style="{StaticResource SettingsHeader}" />
                            <Button Content="Ver barras de prueba" Command="{Binding ShowDemoCommand}" Cursor="Hand" HorizontalAlignment="Left"
                                    Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="12" Padding="0,2"
                                    ToolTip="Una pelea inventada para acomodar tamaño, fuente y opacidad sin combatir" />

                            <TextBlock Text="ATAJOS" Style="{StaticResource SettingsHeader}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
                                        <Setter Property="IsReadOnly" Value="True" />
                                        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="Hacé clic y apretá la combinación nueva; Borrar lo saca" />
                                        <EventSetter Event="PreviewKeyDown" Handler="OnHotkeyKeyDown" />
                                    </Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="8,0,0,0" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" Text="{Binding HotkeyClickThrough, UpdateSourceTrigger=Explicit}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="bloquear / desbloquear clics" />
                                <TextBox Grid.Row="1" Text="{Binding HotkeyReset, UpdateSourceTrigger=Explicit}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="reiniciar el encuentro" />
                                <TextBox Grid.Row="2" Text="{Binding HotkeyVisibility, UpdateSourceTrigger=Explicit}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="ocultar / mostrar el overlay" />
                                <TextBox Grid.Row="3" Text="{Binding HotkeyMark, UpdateSourceTrigger=Explicit}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="marcar este momento de la pelea" />
                            </Grid>
                            <TextBlock Text="{Binding HotkeyMessage}" FontSize="11" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" LineHeight="18">
                                <Run Text="Ctrl+rueda" Foreground="{StaticResource Text}" /><Run Text="  zoom" /><LineBreak />
                                <Run Text="Doble clic arriba" Foreground="{StaticResource Text}" /><Run Text="  modo compacto" />
                            </TextBlock>

                            <TextBlock Text="VERSIÓN" Style="{StaticResource SettingsHeader}" />
                            <TextBlock Text="{Binding Version, Mode=OneTime}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource SettingsHeader}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Diagnostics}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       ToolTip="Frames: mensajes del juego leídos. Conocidos: los que el meter sabe interpretar. Errores o resincronizaciones altos indican un problema de lectura." />
                            <TextBlock Text="{Binding DataFolderHint, Mode=OneTime}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       ToolTip="Para el modo portable, creá un archivo portable.txt junto a HysteriaMeter.exe" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>

            </DockPanel>
        </Border>

        <!-- Agarradera para cambiar ancho y alto. -->
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="0,0,1,1"
               Cursor="SizeNWSE" DragDelta="OnResizeDragDelta" ToolTip="Arrastrá para cambiar el tamaño · Ctrl + rueda para el zoom">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M13,3 L3,13 M13,8 L8,13 M13,12 L12,13" Stroke="{StaticResource GoldDim}" StrokeThickness="1.2" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- Esquinas doradas -->
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0" BorderThickness="2,2,0,0" />
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" BorderThickness="0,2,2,0" />
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-2,0,0,-2" BorderThickness="2,0,0,2" />
        <Border Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" BorderThickness="0,0,2,2" />
    </Grid>
</Window>
