<Window x:Class="HysteriaMeter.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        xmlns:conv="clr-namespace:HysteriaMeter.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MeterViewModel}"
        Title="Hysteria Meter"
        Width="380" Height="300" MinWidth="260" MaxWidth="900" MinHeight="150" MaxHeight="1400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{Binding Font}" FontSize="13" Opacity="{Binding EffectiveOpacity}" MouseEnter="OnMouseEnterWindow" MouseLeave="OnMouseLeaveWindow" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: redesign/project/Main, Estados, Mini, Avisos e Inicio.dc.html (DECISIONES.md). -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding OlderFightCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NewerFightCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <conv:MoveCursorConverter x:Key="MoveCursor" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cuadro de texto del overlay: la nota de la pelea. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <conv:RoundedClipConverter x:Key="RoundedClip" />
        <Style x:Key="LiveIcon" TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="LiveMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" Foreground="{DynamicResource Gold}" />
                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
                        <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="5"><ItemsPresenter/></Border>
                        </Popup>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CaptureCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="Margin" Value="10,12" /><Setter Property="Padding" Value="14,12"/>
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="RowNumber" TargetType="TextBlock" BasedOn="{StaticResource NumberText}">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <DataTemplate x:Key="LiveBadge">
            <Grid Width="20" Height="20" ToolTip="{Binding ClassName}">
                <Border x:Name="Badge" CornerRadius="10" Background="{DynamicResource ClassBadgeBg}" BorderBrush="{Binding BadgeBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image x:Name="Emblem" Width="20" Height="20" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding HasClassEmblem}" Value="True">
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Emblem" Property="Source" Value="{Binding ClassEmblem}"/>
                <Setter TargetName="Emblem" Property="Visibility" Value="Visible"/>
            </DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>


    <!-- El zoom afecta toda la ventana; los avisos no participan del tamaño ni de la imagen exportada. -->
    <Grid x:Name="Root" PreviewMouseWheel="OnPreviewMouseWheel" AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
        <Grid.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
        <Grid Visibility="{Binding IsFullView, Converter={StaticResource Visible}}">
            <Border x:Name="LiveFrame" Background="{DynamicResource Panel}" BorderThickness="1" CornerRadius="10">
                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource GoldDim}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="10,8">
                        <WrapPanel Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="{Binding CanMoveWindow, Converter={StaticResource MoveCursor}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="12" Height="14" Stretch="Fill" Stroke="{DynamicResource Gold}" StrokeThickness="1.6" Data="M8,1 L14,8 L8,15 L2,8 Z"/>
                                    <TextBlock Text="HYSTERIA" Style="{StaticResource LogoText}" Margin="7,0,6,0" VerticalAlignment="Center" ToolTip="{Binding Version}"/>
                                    <Border Style="{StaticResource SegmentBar}" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentTab}" GroupName="MeterTab" Content="DPS" IsChecked="{Binding IsDamageTab}" Padding="6,3"/>
                                            <RadioButton Style="{StaticResource SegmentTabHealing}" GroupName="MeterTab" Content="CURA" IsChecked="{Binding IsHealingTab}" Padding="6,3"/>
                                            <RadioButton Style="{StaticResource SegmentTabTaken}" GroupName="MeterTab" Content="RECIB." IsChecked="{Binding IsTakenTab}" Padding="6,3" ToolTip="Daño recibido de los monstruos; pendiente de validar contra Combat Analysis"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="● REC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DangerStrong}" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{Binding IsRecording, Converter={StaticResource Visible}}" ToolTip="{Binding RecordingHint}"/>
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" ToolTip="{Binding StatusText}">
                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource StatusIdle}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="live"><Setter Property="Fill" Value="{DynamicResource StatusLive}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="ready"><Setter Property="Fill" Value="{DynamicResource StatusLive}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="warn"><Setter Property="Fill" Value="{DynamicResource StatusWarn}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Fill" Value="{DynamicResource StatusError}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Elapsed}" Style="{StaticResource NumberStrong}" FontSize="15" VerticalAlignment="Center" Visibility="{Binding ShowClock, Converter={StaticResource Visible}}"/>
                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{DynamicResource TextMuted}" MaxWidth="70" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShowClock}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button Style="{StaticResource LiveIcon}" Command="{Binding TogglePauseCommand}" ToolTip="Pausar o seguir: la pelea sigue contando" AutomationProperties.Name="Pausar o seguir">
                                    <TextBlock FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Ⅱ"/><Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Text" Value="▶"/><Setter Property="Foreground" Value="{DynamicResource Gold}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Button>
                                <Button Style="{StaticResource LiveIcon}" Command="{Binding ToggleSettingsCommand}" ToolTip="Configuración" AutomationProperties.Name="Configuración">
                                    <Path Style="{StaticResource Icon}" Data="M12,9 A3,3 0 1 0 12.01,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9"/>
                                </Button>
                                <Button x:Name="MoreButton" Style="{StaticResource LiveIcon}" Content="⋯" ToolTip="Más opciones" Click="OnMoreClick" AutomationProperties.Name="Más opciones">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FontFamily="{DynamicResource BodyFont}" ItemContainerStyle="{StaticResource LiveMenuItem}">
                                            <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource LiveMenuItem}"/><Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Track}" Margin="5,4"/></ControlTemplate></Setter.Value></Setter></Style></ContextMenu.Resources>
                                            <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="195"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></ContextMenu.Template>
                                            <MenuItem Header="Historial" Command="{Binding ToggleHistoryCommand}"/>
                                            <MenuItem Header="Reiniciar" Command="{Binding ResetCommand}"/>
                                            <MenuItem Header="Copiar resumen" Command="{Binding CopySummaryCommand}"/>
                                            <MenuItem Header="Nueva ventana" Command="{Binding NewWindowCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Segmento">
                                                <MenuItem Header="PELEA" IsCheckable="True" IsChecked="{Binding IsFightView}"/>
                                                <MenuItem Header="RUN" IsCheckable="True" IsChecked="{Binding IsRunChip}"/>
                                                <MenuItem Header="SESIÓN" IsCheckable="True" IsChecked="{Binding IsSessionChip}"/>
                                            </MenuItem>
                                            <MenuItem Header="Modo compacto" IsCheckable="True" IsChecked="{Binding IsCompact}"/>
                                            <MenuItem Header="Bloquear clics" IsCheckable="True" IsChecked="{Binding IsClickThrough, Mode=OneWay}" Click="OnLockClick"/>
                                            <MenuItem Header="Minimizar" Command="{Binding ToggleMinimizedCommand}"/>
                                            <Separator/><MenuItem Header="Cerrar" Click="OnCloseClick"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" Padding="10,7" Visibility="{Binding IsPauseBannerVisible, Converter={StaticResource Visible}}">
                        <TextBlock Text="Ⅱ  Pausado · la pelea sigue contando" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="NewsCard" DockPanel.Dock="Top" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="0,0,0,1" Padding="14,12" Visibility="{Binding HasNotice, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding NoticeKicker}" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="{Binding NoticeHeading}" Style="{StaticResource WindowTitle}" FontSize="22" Margin="0,4,0,6" Visibility="{Binding HasNoticeHeading, Converter={StaticResource Visible}}"/>
                            <ItemsControl ItemsSource="{Binding NoticeLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Button Content="Entendido" Style="{StaticResource ButtonSoft}" Command="{Binding DismissNoticeCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,5"/>
                        </StackPanel>
                    </Border>
                <!-- Mirando un encuentro guardado -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,0,0,1" Padding="10,3"
                        Visibility="{Binding IsViewingHistory, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <!-- Nota de la pelea guardada: se guarda al salir del cuadro (o con Enter) -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,3,0,1" Visibility="{Binding CanEditNote, Converter={StaticResource Visible}}">
                            <Button DockPanel.Dock="Right" Content="Borrar pelea" Command="{Binding DeleteEncounterCommand}" Cursor="Hand"
                                    Foreground="#E0524A" Background="Transparent" BorderThickness="0" FontSize="11" Padding="6,0,0,0" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding CurrentNote, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnNoteLostFocus" KeyDown="OnNoteKeyDown"
                                     ToolTip="Nota de esta pelea (por ejemplo: rotación nueva, con piedra X). Se puede buscar en el historial." />
                        </DockPanel>
                        <Button DockPanel.Dock="Right" Content="Volver al vivo" Command="{Binding BackToLiveCommand}" Cursor="Hand"
                                Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="11" Padding="4,0" />
                        <Button DockPanel.Dock="Right" Content="›" Command="{Binding NewerFightCommand}" Cursor="Hand" ToolTip="Pelea siguiente (Alt+→)"
                                Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="Bold" Padding="4,0" />
                        <Button DockPanel.Dock="Right" Content="‹" Command="{Binding OlderFightCommand}" Cursor="Hand" ToolTip="Pelea anterior (Alt+←)"
                                Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="Bold" Padding="4,0" />
                        <TextBlock Text="{Binding HistoryLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>


                    <Border x:Name="TargetBlock" DockPanel.Dock="Top" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="12,9,12,10">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasFight}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <Grid>
                            <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding ShowRunBlock}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TargetHealthPercent}" ToolTip="{Binding TargetHealthTip}" Style="{StaticResource NumberStrong}" FontSize="15" Foreground="{DynamicResource GoldBright}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AttemptText}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasAttempt, Converter={StaticResource Visible}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource NumberStrong}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid Height="5" Margin="0,6,0,0" Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}">
                                    <Border Background="{DynamicResource HealthTrack}" CornerRadius="3"/>
                                    <Border Background="{StaticResource Health}" CornerRadius="3" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding TargetHealthRatio}"/></Border.RenderTransform></Border>
                                </Grid>
                                <DockPanel Margin="0,6,0,0" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextDim}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding EnrageText}" Visibility="{Binding HasEnrage, Converter={StaticResource Visible}}"/>
                                    <TextBlock Text="{Binding PartyRateText}"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowRunBlock, Converter={StaticResource Visible}}">
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RunElapsed}" Style="{StaticResource NumberText}" FontSize="14" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="{Binding RunHeader}" Style="{StaticResource NumberStrong}" FontSize="17"/></DockPanel>
                                <ItemsControl ItemsSource="{Binding RunChips}" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border x:Name="Chip" Background="{DynamicResource TagNeutralBg}" CornerRadius="4" Padding="6,2" Margin="0,0,4,3"><TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource TextMuted}"/></Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Kill"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Wipe"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Current"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentTint}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Gold}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="12,7,18,7" Visibility="{Binding ShowFooter, Converter={StaticResource Visible}}">
                        <WrapPanel TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextDim}">
                            <TextBlock ToolTip="{Binding FooterTip}" Margin="0,0,10,0"><Run Text="Total "/><Run Text="{Binding PartyTotal, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PlayersText, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="Clic en una fila: detalle" Foreground="{DynamicResource TextMuted}"/>
                        </WrapPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PauseHint}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="10,6,10,8" Visibility="{Binding IsPauseBannerVisible, Converter={StaticResource Visible}}"/>
                    <Grid>
                        <StackPanel x:Name="WaitingCard" Margin="16,28" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding ShowWaitingCard, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding WaitingTitle}" Style="{StaticResource NumberStrong}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{Binding WaitingDetail}" FontSize="12" Foreground="{DynamicResource TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="NpcapCard" Style="{StaticResource CaptureCard}" BorderBrush="{DynamicResource DangerBorder}" Visibility="{Binding ShowNpcapCard, Converter={StaticResource Visible}}">
                            <StackPanel><TextBlock Text="No se encontró Npcap" Foreground="{DynamicResource Danger}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Instalá Npcap con la compatibilidad WinPcap y reiniciá el meter." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <Button Content="Descargar Npcap ↗" Style="{StaticResource ButtonLink}" Command="{Binding OpenNpcapDownloadCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="TrafficCard" Style="{StaticResource CaptureCard}" BorderBrush="{DynamicResource Warning}" Visibility="{Binding ShowTrafficCard, Converter={StaticResource Visible}}">
                            <StackPanel><TextBlock Text="Capturando, pero no llega nada de AION 2" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Abrí el juego y revisá la placa de red si usás una VPN." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <Button Content="Elegir placa de red" Style="{StaticResource ButtonGhost}" Command="{Binding OpenCaptureSettingsCommand}" HorizontalAlignment="Left" Padding="10,6"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CaptureCard}" BorderBrush="{DynamicResource DangerBorder}" Visibility="{Binding ShowFailedCard, Converter={StaticResource Visible}}">
                            <StackPanel><TextBlock Text="La captura se detuvo" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/><TextBlock Text="{Binding FailedDetail}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,8" TextWrapping="Wrap"/><Button Content="Reportar un problema" Style="{StaticResource ButtonLink}" Command="{Binding ReportProblemCommand}" HorizontalAlignment="Left"/></StackPanel>
                        </Border>
                        <TextBlock Text="{Binding EmptyTabText}" Margin="16,20" Foreground="{DynamicResource TextDim}" TextAlignment="Center" VerticalAlignment="Top" Visibility="{Binding ShowEmptyTabText, Converter={StaticResource Visible}}"/>
                        <ScrollViewer x:Name="ActorScroller" VerticalScrollBarVisibility="Hidden" Visibility="{Binding HasFight, Converter={StaticResource Visible}}">
                            <ScrollViewer.Style><Style TargetType="ScrollViewer">
                                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
                                    <DataTrigger Binding="{Binding ShowColumnHeaders}" Value="True"><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/></DataTrigger>
                                </Style.Triggers>
                            </Style></ScrollViewer.Style>
                            <!-- Cabecera y filas comparten desplazamiento cuando las columnas elegidas no entran. -->
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="15,5,15,0" TextElement.FontSize="10" TextElement.Foreground="{DynamicResource TextDim}" Visibility="{Binding ShowColumnHeaders, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="JUGADOR"/><TextBlock Grid.Column="2" Text="{Binding RateUnit}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SecondColumnHeader}" Width="58" TextAlignment="Right" Visibility="{Binding ShowTotalColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="4" Text="10 s" Width="50" TextAlignment="Right" Visibility="{Binding ShowRecentColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="5" Text="CRIT" Width="42" TextAlignment="Right" Visibility="{Binding ShowCritColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="6" Text="MÁX" Width="50" TextAlignment="Right" Visibility="{Binding ShowMaxHitColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="7" Text="%" Width="46" TextAlignment="Right" Visibility="{Binding ShowShareColumn, Converter={StaticResource Visible}}"/>
                                </Grid>
                            <ItemsControl ItemsSource="{Binding Actors}" Margin="6,6,6,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ActorRowViewModel">
                                        <Border x:Name="Row" Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,3" Background="{DynamicResource Row}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                                            <Border.ToolTip><ToolTip Style="{StaticResource ToolTipDark}" FontFamily="{DynamicResource BodyFont}" MaxWidth="330">
                                                <StackPanel Margin="4,2">
                                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ClassName}" Foreground="{Binding BadgeBrush}" FontSize="12" Margin="16,0,0,0"/><TextBlock Text="{Binding Name}" Style="{StaticResource NumberStrong}" FontSize="17"/></DockPanel>
                                                    <DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding Total}" DockPanel.Dock="Right"/><TextBlock Text="{Binding ValueLabel}" Foreground="{DynamicResource TextMuted}"/></DockPanel>
                                                    <DockPanel Margin="0,5,0,0" Visibility="{Binding HasRecentTip, Converter={StaticResource Visible}}"><TextBlock Text="{Binding RecentTip}" DockPanel.Dock="Right"/><TextBlock Text="DPS últimos 10 s" Foreground="{DynamicResource TextMuted}"/></DockPanel>
                                                    <DockPanel Margin="0,5,0,0"><TextBlock Text="{Binding Crit}" DockPanel.Dock="Right"/><TextBlock Text="Críticos" Foreground="{DynamicResource TextMuted}"/></DockPanel>
                                                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding HasTopSkill, Converter={StaticResource Visible}}"><Run Text="Skill top · " Foreground="{DynamicResource TextMuted}"/><Run Text="{Binding TopSkill, Mode=OneWay}"/></TextBlock>
                                                    <TextBlock Text="{Binding TipGear, StringFormat='iLvl · Power: {0}'}" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0" Visibility="{Binding HasTipGear, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Text="{Binding Breakdown}" Foreground="{DynamicResource TextDim}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip></Border.ToolTip>
                                            <Grid x:Name="RowContent">
                                                <Grid.Clip><MultiBinding Converter="{StaticResource RoundedClip}"><Binding Path="ActualWidth" ElementName="RowContent"/><Binding Path="ActualHeight" ElementName="RowContent"/><Binding Path="CornerRadius" ElementName="Row"/></MultiBinding></Grid.Clip>
                                                <Rectangle Fill="{Binding BarFill}"><Rectangle.RenderTransform><ScaleTransform ScaleX="{Binding Bar}"/></Rectangle.RenderTransform></Rectangle>
                                                <Polyline Points="{Binding Spark}" Stretch="Fill" Stroke="{Binding Accent}" StrokeThickness="1" Opacity="0.35" Margin="0,5" IsHitTestVisible="False"/>
                                                <Grid Margin="6,0,9,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Rank}" Style="{StaticResource RowNumber}" FontSize="13" Foreground="{DynamicResource TextDim}"/>
                                                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource LiveBadge}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Gear}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="5,0,0,0" Visibility="{Binding HasGear, Converter={StaticResource Visible}}"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Trend}" FontSize="10" Margin="5,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding Trend}" Value="▲"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        <TextBlock x:Name="NameText" Text="{Binding DisplayName}" FontSize="{Binding DataContext.RowNameSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock x:Name="PerSecondText" Grid.Column="3" Text="{Binding PerSecond}" Style="{StaticResource RowNumber}" FontSize="{Binding DataContext.RowValueSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                                    <TextBlock x:Name="TotalText" Grid.Column="4" Text="{Binding Total}" Style="{StaticResource RowNumber}" Width="58" Visibility="{Binding DataContext.ShowTotalColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Recent}" Style="{StaticResource RowNumber}" Width="50" Visibility="{Binding DataContext.ShowRecentColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Crit}" Style="{StaticResource RowNumber}" Width="42" Visibility="{Binding DataContext.ShowCritColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding MaxHitText}" Style="{StaticResource RowNumber}" Width="50" Visibility="{Binding DataContext.ShowMaxHitColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding Share}" Style="{StaticResource RowNumber}" Width="46" Visibility="{Binding DataContext.ShowShareColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowHealingColumn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="TotalText" Property="Text" Value="{Binding HealingPerSecond}"/><Setter TargetName="TotalText" Property="Foreground" Value="{DynamicResource Healing}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="Row" Property="Height" Value="22"/><Setter TargetName="Row" Property="CornerRadius" Value="4"/><Setter TargetName="Row" Property="Margin" Value="0,0,0,2"/><Setter TargetName="NameText" Property="FontSize" Value="13"/><Setter TargetName="PerSecondText" Property="FontSize" Value="13"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RowBorderLocal}"/><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource NameLocal}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </DockPanel>
                        </ScrollViewer>

                        <!-- Avisos superpuestos: no desplazan las filas; solo la ventana principal. -->
                        <StackPanel x:Name="ToastLayer" VerticalAlignment="Top" Margin="10,8" Visibility="{Binding ShowsToasts, Converter={StaticResource Visible}}">
                            <Border Style="{StaticResource ToastPanel}" Margin="0,0,0,5" Visibility="{Binding HasBossNotice, Converter={StaticResource Visible}}">
                                <StackPanel><TextBlock Text="BOSS DETECTADO" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BossNoticeName}" Style="{StaticResource NumberStrong}" FontSize="18" Margin="0,4,0,3"/><TextBlock Text="{Binding BossNoticeDetail}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource ToastPanel}" Background="{DynamicResource AlertBg}" BorderBrush="{DynamicResource DangerStrong}" Margin="0,0,0,5" Visibility="{Binding IsEnrageDanger, Converter={StaticResource Visible}}">
                                <StackPanel><TextBlock Text="{Binding EnrageAlertTitle}" Foreground="{DynamicResource OnDanger}" FontSize="13" FontWeight="Bold"/><TextBlock Text="{Binding EnrageAlertDetail}" Foreground="{DynamicResource OnDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource ToastPanel}" BorderBrush="{DynamicResource SuccessLine}" Margin="0,0,0,5" Visibility="{Binding HasSavedNotice, Converter={StaticResource Visible}}">
                                <DockPanel><Button DockPanel.Dock="Right" Content="Abrir" Command="{Binding OpenExportsCommand}" Style="{StaticResource ButtonLink}"/><TextBlock Text="{Binding SavedNoticeText}" ToolTip="{Binding SavedNoticePath}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                            </Border>
                            <Border Style="{StaticResource ToastPanel}" Margin="0,0,0,5" Visibility="{Binding HasRecordMessage, Converter={StaticResource Visible}}"><TextBlock Text="{Binding RecordMessage}" Foreground="{DynamicResource Gold}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
                            <Border Style="{StaticResource ToastPanel}" BorderBrush="{DynamicResource Warning}" Visibility="{Binding ShowPatchNotice, Converter={StaticResource Visible}}">
                                <StackPanel><TextBlock Text="Puede que el juego se haya actualizado" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Llegan paquetes, pero no se reconocen. Revisá si hay una versión nueva del meter." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,6"/><Button Content="Reportar un problema" Command="{Binding ReportProblemCommand}" Style="{StaticResource ButtonLink}" HorizontalAlignment="Left"/></StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </DockPanel>
            </Border>
            <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="0,0,3,3" Visibility="{Binding CanMoveWindow, Converter={StaticResource Visible}}" Cursor="SizeNWSE" DragDelta="OnResizeDragDelta" ToolTip="Arrastrá para cambiar el tamaño · Ctrl + rueda para el zoom">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M13,3 L3,13 M13,8 L8,13 M13,12 L12,13" Stroke="{DynamicResource TextDim}" StrokeThickness="1"/></Grid></ControlTemplate></Thumb.Template>
            </Thumb>
        </Grid>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="20" Padding="10,6,6,6" Cursor="{Binding CanMoveWindow, Converter={StaticResource MoveCursor}}" MouseLeftButtonDown="OnHeaderMouseDown" Visibility="{Binding IsMinimized, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <ContentControl Content="{Binding PillRow}" ContentTemplate="{StaticResource LiveBadge}" VerticalAlignment="Center" Visibility="{Binding HasPillRow, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding PillRow.PerSecond}" Style="{StaticResource NumberStrong}" FontSize="19" Margin="8,0,4,0" VerticalAlignment="Center" Visibility="{Binding HasPillRow, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding RateUnit}" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding HasPillRow, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding PillRankText}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasPillRow, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding MinimizedText}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasPillRow}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <Button Style="{StaticResource LiveIcon}" Content="↗" Command="{Binding ToggleMinimizedCommand}" ToolTip="Abrir el overlay"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
