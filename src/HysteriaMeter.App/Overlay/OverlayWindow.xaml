<Window x:Class="HysteriaMeter.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HysteriaMeter.App.ViewModels"
        xmlns:conv="clr-namespace:HysteriaMeter.App.Converters"
        xmlns:welcome="clr-namespace:HysteriaMeter.App.Welcome"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MeterViewModel}"
        Title="Hysteria Meter"
        Width="380" Height="300" MinWidth="260" MaxWidth="900" MinHeight="150" MaxHeight="1400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{Binding Font}" FontSize="13" Opacity="{Binding EffectiveOpacity}" MouseEnter="OnMouseEnterWindow" MouseLeave="OnMouseLeaveWindow" Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display">

    <!-- Referencia visual: redesign/project/Main, Estados, Mini, Avisos e Inicio.dc.html (DECISIONES.md). -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding OlderFightCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NewerFightCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <conv:MoveCursorConverter x:Key="MoveCursor" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GoldDim}" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cuadro de texto del overlay: la nota de la pelea. Fondo de las cajas de texto (InputBg), como InputBox. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Gold}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <conv:RoundedClipConverter x:Key="RoundedClip" />
        <conv:OverlayNarrowConverter x:Key="OverlayNarrow" />
        <Style x:Key="LiveIcon" TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="LiveMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" Foreground="{DynamicResource Gold}" />
                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
                        <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="5"><ItemsPresenter/></Border>
                        </Popup>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CaptureCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="Margin" Value="10,12" /><Setter Property="Padding" Value="14,12"/>
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="RowNumber" TargetType="TextBlock" BasedOn="{StaticResource NumberText}">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <DataTemplate x:Key="LiveBadge">
            <Grid Width="20" Height="20" ToolTip="{Binding ClassName}">
                <Border x:Name="Badge" CornerRadius="10" Background="{DynamicResource ClassBadgeBg}" BorderBrush="{Binding BadgeBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image x:Name="Emblem" Width="20" Height="20" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding HasClassEmblem}" Value="True">
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Emblem" Property="Source" Value="{Binding ClassEmblem}"/>
                <Setter TargetName="Emblem" Property="Visibility" Value="Visible"/>
            </DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
<ContextMenu x:Key="OverlayMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FontFamily="{DynamicResource BodyFont}" ItemContainerStyle="{StaticResource LiveMenuItem}">
                                            <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource LiveMenuItem}"/><Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Track}" Margin="5,4"/></ControlTemplate></Setter.Value></Setter></Style></ContextMenu.Resources>
                                            <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="195"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></ContextMenu.Template>
                                            <MenuItem Header="Configuración" Command="{Binding ToggleSettingsCommand}"/>
                                            <MenuItem Header="Pausar / seguir" Command="{Binding TogglePauseCommand}"/>
                                            <MenuItem Header="Historial" Command="{Binding ToggleHistoryCommand}"/>
                                            <MenuItem Header="Reiniciar" Command="{Binding ResetCommand}"/>
                                            <MenuItem Header="Copiar resumen" Command="{Binding CopySummaryCommand}"/>
                                            <MenuItem Header="Nueva ventana" Command="{Binding NewWindowCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Pestaña">
                                                <MenuItem Header="DPS" IsCheckable="True" IsChecked="{Binding IsDamageTab}"/>
                                                <MenuItem Header="CURA" IsCheckable="True" IsChecked="{Binding IsHealingTab}"/>
                                                <MenuItem Header="RECIBIDO" IsCheckable="True" IsChecked="{Binding IsTakenTab}"/>
                                            </MenuItem>
                                            <MenuItem Header="Segmento">
                                                <MenuItem Header="PELEA" IsCheckable="True" IsChecked="{Binding IsFightView}"/>
                                                <MenuItem Header="RUN" IsCheckable="True" IsChecked="{Binding IsRunChip}"/>
                                                <MenuItem Header="SESIÓN" IsCheckable="True" IsChecked="{Binding IsSessionChip}"/>
                                            </MenuItem>
                                            <MenuItem Header="Modo compacto" IsCheckable="True" IsChecked="{Binding IsCompact}"/>
                                            <MenuItem Header="Bloquear clics" IsCheckable="True" IsChecked="{Binding IsClickThrough, Mode=OneWay}" Click="OnLockClick"/>
                                            <MenuItem Header="Minimizar" Command="{Binding ToggleMinimizedCommand}"/>
                                            <Separator/><MenuItem Header="Cerrar" Click="OnCloseClick"/>
                                        </ContextMenu>
        <!-- "● REC" y el punto de estado: en el encabezado y en la franja de pausa (decisiones: se conservan los dos). -->
        <Style x:Key="RecBadge" TargetType="TextBlock">
            <Setter Property="Text" Value="● REC"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerStrong}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Visibility" Value="{Binding IsRecording, Converter={StaticResource Visible}}"/><Setter Property="ToolTip" Value="{Binding RecordingHint}"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding StatusText}"/>
            <Setter Property="Fill" Value="{DynamicResource StatusIdle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="live"><Setter Property="Fill" Value="{DynamicResource StatusLive}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="ready"><Setter Property="Fill" Value="{DynamicResource StatusLive}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warn"><Setter Property="Fill" Value="{DynamicResource StatusWarn}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Fill" Value="{DynamicResource StatusError}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MiniBadge">
            <Grid Width="22" Height="22" ToolTip="{Binding ClassName}">
                <Border x:Name="Badge" CornerRadius="11" Background="{DynamicResource ClassBadgeBg}" BorderBrush="{Binding BadgeBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image x:Name="Emblem" Width="22" Height="22" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding HasClassEmblem}" Value="True">
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Emblem" Property="Source" Value="{Binding ClassEmblem}"/>
                <Setter TargetName="Emblem" Property="Visibility" Value="Visible"/>
            </DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>


    <!-- El zoom afecta toda la ventana; los avisos no participan del tamaño ni de la imagen exportada. -->
    <Grid x:Name="Root" PreviewMouseWheel="OnPreviewMouseWheel" AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
        <Grid.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
        <Grid Visibility="{Binding IsFullView, Converter={StaticResource Visible}}">
            <Border x:Name="LiveFrame" Background="{DynamicResource Panel}" BorderThickness="1" CornerRadius="10">
                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource GoldDim}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PauseBorder}"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <!-- Encabezado arriba y cuerpo abajo. Las novedades flotan sobre el cuerpo (no empujan la pelea) y su alto lo
                     pone esa fila: nunca pasan del alto de la ventana. -->
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                    <Border x:Name="LiveHeader" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="10,8">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <Grid x:Name="LiveHeaderGrid" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="{Binding CanMoveWindow, Converter={StaticResource MoveCursor}}">
                            <!-- En modo compacto la franja no muestra las pestañas: el tooltip dice cómo salir y dónde cambiarlas. -->
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="ToolTip" Value="Modo compacto: doble clic acá o ⋯ › Modo compacto para salir. La pestaña se cambia en ⋯ › Pestaña."/></DataTrigger>
                            </Style.Triggers></Style></Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Gold}" StrokeThickness="1.6" Data="M8,1 L14,8 L8,15 L2,8 Z"/>
                                <TextBlock Text="HYSTERIA" Style="{StaticResource LogoText}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Version}"/>
                            </StackPanel>
                            <Border x:Name="LiveTabs">
                                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SegmentBar}">
                                    <Setter Property="Grid.Column" Value="1"/><Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=LiveHeaderGrid, Converter={StaticResource OverlayNarrow}, ConverterParameter=350}" Value="True">
                                            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="Margin" Value="0,6,0,0"/>
                                        </DataTrigger>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRecording}" Value="True"/>
                                            <Condition Binding="{Binding ActualWidth, ElementName=LiveHeaderGrid, Converter={StaticResource OverlayNarrow}, ConverterParameter=390}" Value="True"/>
                                        </MultiDataTrigger.Conditions><MultiDataTrigger.Setters>
                                            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="Margin" Value="0,6,0,0"/>
                                        </MultiDataTrigger.Setters></MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HasFight}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentTab}" GroupName="MeterTab" Content="DPS" IsChecked="{Binding IsDamageTab}" Padding="9,3"/>
                                    <RadioButton Style="{StaticResource SegmentTabHealing}" GroupName="MeterTab" Content="CURA" IsChecked="{Binding IsHealingTab}" Padding="9,3"/>
                                    <RadioButton Style="{StaticResource SegmentTabTaken}" GroupName="MeterTab" Content="RECIB." IsChecked="{Binding IsTakenTab}" Padding="9,3" ToolTip="Daño recibido de los monstruos; pendiente de validar contra Combat Analysis"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="LiveActions" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Style="{StaticResource RecBadge}"/>
                                <Ellipse Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="{Binding Elapsed}" Style="{StaticResource NumberText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding ShowClock, Converter={StaticResource Visible}}"/>
                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{DynamicResource TextMuted}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShowClock}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button Style="{StaticResource LiveIcon}" Command="{Binding TogglePauseCommand}" Visibility="{Binding HasFight, Converter={StaticResource Visible}}" ToolTip="Pausar: la pelea sigue contando" AutomationProperties.Name="Pausar">
                                    <Path Width="12" Height="12" Stroke="{DynamicResource TextDim}" StrokeThickness="1.8" Data="M3,2 V10 M9,2 V10"/>
                                </Button>
                                <Button Style="{StaticResource LiveIcon}" Command="{Binding ToggleSettingsCommand}" Visibility="{Binding HasFight, Converter={StaticResource Visible}}" ToolTip="Configuración" AutomationProperties.Name="Configuración">
                                    <Path Style="{StaticResource Icon}" Data="M12,9 A3,3 0 1 0 12.01,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9"/>
                                </Button>
                                <Button x:Name="MoreButton" Style="{StaticResource LiveIcon}" Content="⋯" ToolTip="Más opciones" Click="OnMoreClick" AutomationProperties.Name="Más opciones" ContextMenu="{StaticResource OverlayMenu}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="PauseHeader" Background="{DynamicResource AccentSoft}" CornerRadius="9,9,0,0" Padding="10,8" Visibility="{Binding IsPauseBannerVisible, Converter={StaticResource Visible}}" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="{Binding CanMoveWindow, Converter={StaticResource MoveCursor}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LiveIcon}" Content="⋯" Click="OnMoreClick" ContextMenu="{StaticResource OverlayMenu}" ToolTip="Más opciones" AutomationProperties.Name="Más opciones"/>
                            <StackPanel x:Name="PauseStatus" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                                <TextBlock Style="{StaticResource RecBadge}"/>
                                <Ellipse Style="{StaticResource StatusDot}" Margin="0"/>
                            </StackPanel>
                            <Button x:Name="ResumeButton" DockPanel.Dock="Left" Style="{StaticResource LiveIcon}" Width="12" Margin="0,0,6,0" Command="{Binding TogglePauseCommand}" ToolTip="Seguir" AutomationProperties.Name="Seguir">
                                <Path Width="12" Height="12" Stroke="{DynamicResource Gold}" StrokeThickness="1.8" Data="M3,2 V10 M9,2 V10"/>
                            </Button>
                            <TextBlock Text="Pausado — la pelea sigue contando" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    </StackPanel>
                    <DockPanel x:Name="LiveBody" Grid.Row="1">
                <!-- Mirando un encuentro guardado -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" BorderBrush="{StaticResource RuleDim}" BorderThickness="0,0,0,1" Padding="10,3"
                        Visibility="{Binding IsViewingHistory, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <!-- Nota de la pelea guardada: se guarda al salir del cuadro (o con Enter) -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,3,0,1" Visibility="{Binding CanEditNote, Converter={StaticResource Visible}}">
                            <Button x:Name="DeleteEncounterButton" DockPanel.Dock="Right" Style="{StaticResource ButtonDangerLink}" Content="Borrar pelea"
                                    Command="{Binding DeleteEncounterCommand}" FontSize="11" Padding="6,0,0,0" />
                            <TextBox x:Name="NoteBox" Style="{StaticResource Field}" Text="{Binding CurrentNote, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnNoteLostFocus" KeyDown="OnNoteKeyDown"
                                     ToolTip="Nota de esta pelea (por ejemplo: rotación nueva, con piedra X). Se puede buscar en el historial." />
                        </DockPanel>
                        <!-- Links con el acento del tema (DynamicResource: se repintan al cambiarlo con la pelea abierta). -->
                        <Button x:Name="BackToLiveButton" DockPanel.Dock="Right" Style="{StaticResource ButtonLink}" Content="Volver al vivo"
                                Command="{Binding BackToLiveCommand}" FontSize="11" Padding="4,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonLink}" Content="›" Command="{Binding NewerFightCommand}" ToolTip="Pelea siguiente (Alt+→)"
                                FontSize="13" FontWeight="Bold" Padding="4,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonLink}" Content="‹" Command="{Binding OlderFightCommand}" ToolTip="Pelea anterior (Alt+←)"
                                FontSize="13" FontWeight="Bold" Padding="4,0" />
                        <TextBlock x:Name="HistoryLabelText" Text="{Binding HistoryLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>


                    <Border x:Name="TargetBlock" DockPanel.Dock="Top" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="12,9,12,10">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasFight}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <Grid>
                            <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding ShowRunBlock}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TargetHealthPercent}" ToolTip="{Binding TargetHealthTip}" Style="{StaticResource NumberText}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource GoldBright}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AttemptText}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasAttempt, Converter={StaticResource Visible}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource NumberText}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <!-- Como el mock: el riel redondeado recorta el relleno, que no lleva radio propio (si no, el borde derecho
                                     del relleno sale redondeado en medio de la barra). -->
                                <Grid x:Name="HealthBar" Height="5" Margin="0,6,0,0" Visibility="{Binding HasTargetHealth, Converter={StaticResource Visible}}">
                                    <Grid.Clip><MultiBinding Converter="{StaticResource RoundedClip}"><Binding Path="ActualWidth" ElementName="HealthBar"/><Binding Path="ActualHeight" ElementName="HealthBar"/><Binding Path="CornerRadius" ElementName="HealthRail"/></MultiBinding></Grid.Clip>
                                    <Border x:Name="HealthRail" Background="{DynamicResource HealthTrack}" CornerRadius="3"/>
                                    <Border Background="{StaticResource Health}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding TargetHealthRatio}"/></Border.RenderTransform></Border>
                                </Grid>
                                <DockPanel Margin="0,6,0,0" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextDim}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding EnrageText}" Visibility="{Binding HasEnrage, Converter={StaticResource Visible}}"/>
                                    <TextBlock Text="{Binding PartyRateText}"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowRunBlock, Converter={StaticResource Visible}}">
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RunElapsed}" Style="{StaticResource NumberText}" FontSize="14" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="{Binding RunHeader}" Style="{StaticResource NumberText}" FontWeight="SemiBold" FontSize="16"/></DockPanel>
                                <ItemsControl ItemsSource="{Binding RunChips}" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border x:Name="Chip" Background="{DynamicResource TagNeutralBg}" CornerRadius="4" Padding="6,2" Margin="0,0,4,3"><TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource TextMuted}"/></Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Kill"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Wipe"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Current"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentTint}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Gold}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="LiveFooter" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="12,7">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="{Binding ShowFooter, Converter={StaticResource Visible}}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <Grid x:Name="FooterGrid" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextDim}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock ToolTip="{Binding FooterTip}" Margin="0,0,10,0"><Run Text="Total "/><Run Text="{Binding PartyTotal, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PlayersText, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="Clic en una fila: detalle" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Grid.Column" Value="1"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ActualWidth, ElementName=FooterGrid, Converter={StaticResource OverlayNarrow}, ConverterParameter=320}" Value="True">
                                        <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,4,0,0"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PauseHint}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="10,6,10,10" Visibility="{Binding IsPauseBannerVisible, Converter={StaticResource Visible}}"/>
                    <Grid>
                        <StackPanel x:Name="WaitingCard" Margin="16,28" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding ShowWaitingCard, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding WaitingTitle}" Style="{StaticResource NumberText}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{Binding WaitingDetail}" FontSize="12" Foreground="{DynamicResource TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="NpcapCard" Style="{StaticResource CaptureCard}" BorderBrush="{DynamicResource DangerBorder}" Visibility="{Binding ShowNpcapCard, Converter={StaticResource Visible}}">
                            <StackPanel><TextBlock Text="No se encontró Npcap" Foreground="{DynamicResource Danger}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Static welcome:WelcomeViewModel.NpcapMissingText}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <Button Content="Descargar Npcap ↗" Style="{StaticResource ButtonLink}" Command="{Binding OpenNpcapDownloadCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="TrafficCard" Style="{StaticResource CaptureCard}" BorderBrush="{DynamicResource WarningLine}" Visibility="{Binding ShowTrafficCard, Converter={StaticResource Visible}}">
                            <StackPanel><TextBlock Text="Capturando, pero no llega nada de AION 2" Foreground="{DynamicResource Warning}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="¿Está abierto el juego? Si usás VPN o varias placas de red, elegí la correcta en Configuración → Captura." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <Button Content="Elegir placa de red" Style="{StaticResource ButtonGhost}" Command="{Binding OpenCaptureSettingsCommand}" HorizontalAlignment="Left" Padding="10,6"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CaptureCard}" BorderBrush="{DynamicResource DangerBorder}" Visibility="{Binding ShowFailedCard, Converter={StaticResource Visible}}">
                            <StackPanel><TextBlock Text="La captura se detuvo" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/><TextBlock Text="{Binding FailedDetail}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,8" TextWrapping="Wrap"/><Button Content="Reportar un problema" Style="{StaticResource ButtonSoft}" Command="{Binding ReportProblemCommand}" HorizontalAlignment="Left"/></StackPanel>
                        </Border>
                        <TextBlock Text="{Binding EmptyTabText}" Margin="16,20" Foreground="{DynamicResource TextDim}" TextAlignment="Center" VerticalAlignment="Top" Visibility="{Binding ShowEmptyTabText, Converter={StaticResource Visible}}"/>
                        <ScrollViewer x:Name="ActorScroller" VerticalScrollBarVisibility="Hidden" Visibility="{Binding HasFight, Converter={StaticResource Visible}}">
                            <ScrollViewer.Style><Style TargetType="ScrollViewer">
                                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
                                    <DataTrigger Binding="{Binding ShowColumnHeaders}" Value="True"><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/></DataTrigger>
                                </Style.Triggers>
                            </Style></ScrollViewer.Style>
                            <!-- Cabecera y filas comparten desplazamiento cuando las columnas elegidas no entran. -->
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="15,5,15,0" TextElement.FontSize="10" TextElement.Foreground="{DynamicResource TextDim}">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="{Binding ShowColumnHeaders, Converter={StaticResource Visible}}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsPauseBannerVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style></Grid.Style>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="JUGADOR"/><TextBlock Grid.Column="2" Text="{Binding RateUnit}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SecondColumnHeader}" Width="58" TextAlignment="Right" Visibility="{Binding ShowTotalColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="4" Text="10 s" Width="50" TextAlignment="Right" Visibility="{Binding ShowRecentColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="5" Text="CRIT" Width="42" TextAlignment="Right" Visibility="{Binding ShowCritColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="6" Text="MÁX" Width="50" TextAlignment="Right" Visibility="{Binding ShowMaxHitColumn, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="7" Text="%" Width="48" TextAlignment="Right" Visibility="{Binding ShowShareColumn, Converter={StaticResource Visible}}"/>
                                </Grid>
                            <ItemsControl ItemsSource="{Binding Actors}" Margin="6,6,6,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ActorRowViewModel">
                                        <Border x:Name="Row" Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="{Binding DataContext.RowGap, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource Row}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{Binding DataContext.RowCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                                            <Border.ToolTip><ToolTip Style="{StaticResource ToolTipDark}" FontFamily="{DynamicResource BodyFont}" MaxWidth="330">
                                                <StackPanel Margin="4,2">
                                                    <TextBlock Style="{StaticResource NumberStrong}" FontSize="17" TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ClassName, Mode=OneWay}" FontFamily="{DynamicResource BodyFont}" FontSize="12" FontWeight="Medium" Foreground="{Binding BadgeBrush}"/></TextBlock>
                                                    <Grid TextElement.FontSize="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding ValueLabel}" Foreground="{DynamicResource TextDim}" Margin="0,6,18,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Total}" TextAlignment="Right" Margin="0,6,0,0"/>
                                                        <TextBlock Grid.Row="1" Text="DPS últimos 10 s" Foreground="{DynamicResource TextDim}" Margin="0,6,18,0" Visibility="{Binding HasRecentTip, Converter={StaticResource Visible}}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RecentTip}" TextAlignment="Right" Margin="0,6,0,0" Visibility="{Binding HasRecentTip, Converter={StaticResource Visible}}"/>
                                                        <TextBlock Grid.Row="2" Text="Críticos" Foreground="{DynamicResource TextDim}" Margin="0,6,18,0" Visibility="{Binding HasCrit, Converter={StaticResource Visible}}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Crit}" TextAlignment="Right" Margin="0,6,0,0" Visibility="{Binding HasCrit, Converter={StaticResource Visible}}"/>
                                                        <TextBlock Grid.Row="3" Text="Skill top" Foreground="{DynamicResource TextDim}" Margin="0,6,18,0" Visibility="{Binding HasTopSkill, Converter={StaticResource Visible}}"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TopSkill}" TextAlignment="Right" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasTopSkill, Converter={StaticResource Visible}}"/>
                                                        <TextBlock Grid.Row="4" Text="iLvl · Power" Foreground="{DynamicResource TextDim}" Margin="0,6,18,0" Visibility="{Binding HasTipGear, Converter={StaticResource Visible}}"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TipGear}" TextAlignment="Right" Margin="0,6,0,0" Visibility="{Binding HasTipGear, Converter={StaticResource Visible}}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Breakdown}" Foreground="{DynamicResource TextDim}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip></Border.ToolTip>
                                            <Grid x:Name="RowContent">
                                                <Grid.Clip><MultiBinding Converter="{StaticResource RoundedClip}"><Binding Path="ActualWidth" ElementName="RowContent"/><Binding Path="ActualHeight" ElementName="RowContent"/><Binding Path="CornerRadius" ElementName="Row"/></MultiBinding></Grid.Clip>
                                                <Rectangle Fill="{Binding BarFill}"><Rectangle.RenderTransform><ScaleTransform ScaleX="{Binding Bar}"/></Rectangle.RenderTransform></Rectangle>
                                                <Polyline x:Name="RowSpark" Points="{Binding Spark}" Stretch="Fill" Stroke="{Binding Accent}" StrokeThickness="1" Opacity="0.35" Margin="0,5" IsHitTestVisible="False"/>
                                                <Grid x:Name="FullRowCells" Margin="6,0,9,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Rank}" Style="{StaticResource RowNumber}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextDim}"/>
                                                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource LiveBadge}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Gear}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="5,0,0,0" Visibility="{Binding HasGear, Converter={StaticResource Visible}}"/>
                                                        <!-- Como los tramos del dungeon: si no entra, se recorta solo el nombre (en el mock la elipsis es solo del nombre);
                                                             la cruz de muertes (Barlow no la trae: SymbolFont) y la tendencia van pegadas a continuación y se ven siempre.
                                                             El nombre entero está en el tooltip de la fila. -->
                                                        <DockPanel HorizontalAlignment="Left">
                                                            <TextBlock x:Name="TrendText" DockPanel.Dock="Right" Text="{Binding Trend}" FontFamily="{DynamicResource SymbolFont}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding Trend}" Value="▲"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding Trend}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                            <TextBlock x:Name="DeathMark" DockPanel.Dock="Right" Text="{Binding DeathText}" FontFamily="{DynamicResource SymbolFont}" FontSize="{Binding DataContext.RowNameSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DeathText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontFamily="{DynamicResource NumberFont}" FontSize="{Binding DataContext.RowNameSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </DockPanel>
                                                    <TextBlock x:Name="PerSecondText" Grid.Column="3" Text="{Binding PerSecond}" Style="{StaticResource RowNumber}" FontSize="{Binding DataContext.RowValueSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                                    <TextBlock x:Name="TotalText" Grid.Column="4" Text="{Binding Total}" Style="{StaticResource RowNumber}" Width="58" Visibility="{Binding DataContext.ShowTotalColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Recent}" Style="{StaticResource RowNumber}" Width="50" Visibility="{Binding DataContext.ShowRecentColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Crit}" Style="{StaticResource RowNumber}" Width="42" Visibility="{Binding DataContext.ShowCritColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding MaxHitText}" Style="{StaticResource RowNumber}" Width="50" Visibility="{Binding DataContext.ShowMaxHitColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding Share}" Style="{StaticResource RowNumber}" FontFamily="{DynamicResource BodyFont}" FontSize="11" FontWeight="Normal" Width="48" Visibility="{Binding DataContext.ShowShareColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                                                </Grid>
                                                <DockPanel x:Name="PauseRowCells" Visibility="Collapsed" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PauseRowDps" DockPanel.Dock="Right" Text="{Binding PerSecond}" FontFamily="{DynamicResource NumberFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="8,0,0,0"/>
                                                    <!-- Como la fila entera: si no entra, se recorta el nombre y la cruz queda a la vista. -->
                                                    <DockPanel HorizontalAlignment="Left">
                                                        <TextBlock x:Name="PauseRowDeath" DockPanel.Dock="Right" Text="{Binding DeathText}" FontFamily="{DynamicResource SymbolFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DeathText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        <TextBlock x:Name="PauseRowName" FontFamily="{DynamicResource NumberFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Rank, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                                    </DockPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowHealingColumn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="TotalText" Property="Text" Value="{Binding HealingPerSecond}"/><Setter TargetName="TotalText" Property="Foreground" Value="{DynamicResource Healing}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsPauseBannerVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="FullRowCells" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="PauseRowCells" Property="Visibility" Value="Visible"/><Setter TargetName="RowSpark" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="Row" Property="Height" Value="22"/><Setter TargetName="Row" Property="CornerRadius" Value="4"/><Setter TargetName="Row" Property="Margin" Value="0,0,0,2"/><Setter TargetName="NameText" Property="FontSize" Value="13"/><Setter TargetName="DeathMark" Property="FontSize" Value="13"/><Setter TargetName="PerSecondText" Property="FontSize" Value="13"/><Setter TargetName="PauseRowName" Property="FontSize" Value="13"/><Setter TargetName="PauseRowDeath" Property="FontSize" Value="13"/><Setter TargetName="PauseRowDps" Property="FontSize" Value="13"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RowBorderLocal}"/><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource NameLocal}"/><Setter TargetName="DeathMark" Property="Foreground" Value="{DynamicResource NameLocal}"/><Setter TargetName="PauseRowName" Property="Foreground" Value="{DynamicResource NameLocal}"/><Setter TargetName="PauseRowDeath" Property="Foreground" Value="{DynamicResource NameLocal}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </DockPanel>
                        </ScrollViewer>

                        <!-- Avisos superpuestos: no desplazan las filas; solo la ventana principal. -->
                        <StackPanel x:Name="ToastLayer" VerticalAlignment="Top" Margin="10,8" Visibility="{Binding ShowsToasts, Converter={StaticResource Visible}}">
                            <Border Style="{StaticResource ToastPanel}" Padding="14,12" Margin="0,0,0,5" Visibility="{Binding HasBossNotice, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="BOSS · PELEA NUEVA" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="{Binding BossNoticeName}" Style="{StaticResource NumberStrong}" FontSize="20" Margin="0,4,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding BossNoticeDetail}" FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="EnrageAlert" Margin="0,0,0,5" Visibility="{Binding IsEnrageDanger, Converter={StaticResource Visible}}">
                            <!-- El brillo (GlowDanger) va en un Border propio detrás del aviso: un efecto sobre el texto le saca ClearType.
                                 Ese Border lleva el único AlertBg y el aviso de encima va transparente: dos capas al 92 % quedaban casi opacas. -->
                            <Border Background="{DynamicResource AlertBg}" CornerRadius="{StaticResource RadiusCard}" Effect="{StaticResource GlowDanger}"/>
                            <Border Style="{StaticResource ToastPanel}" Background="Transparent" BorderBrush="{DynamicResource DangerStrong}" Padding="14,12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource OnDanger}" StrokeThickness="2" Data="M12,3 L22,20 H2 Z M12,10 V14 M12,17 V17.5"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding EnrageAlertTitle}" Style="{StaticResource NumberStrong}" Foreground="{DynamicResource Text}" FontSize="20" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding EnrageAlertDetail}" Foreground="{DynamicResource OnDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </Grid>
                            <Border Style="{StaticResource ToastPanel}" BorderBrush="{DynamicResource SuccessLine}" Padding="14,10" Margin="0,0,0,5" Visibility="{Binding HasSavedNotice, Converter={StaticResource Visible}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Abrir" Command="{Binding OpenExportsCommand}" Style="{StaticResource ButtonLink}" FontSize="12" Margin="10,0,0,0"/>
                                    <TextBlock DockPanel.Dock="Left" Text="✓" Foreground="{DynamicResource Success}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SavedNoticeText}" ToolTip="{Binding SavedNoticePath}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource ToastPanel}" Margin="0,0,0,5" Visibility="{Binding HasRecordMessage, Converter={StaticResource Visible}}"><TextBlock Text="{Binding RecordMessage}" Foreground="{DynamicResource Gold}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
                            <Border Style="{StaticResource ToastPanel}" BorderBrush="{DynamicResource Warning}" Visibility="{Binding ShowPatchNotice, Converter={StaticResource Visible}}">
                                <StackPanel><TextBlock Text="Puede que el juego se haya actualizado" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Los números pueden faltar hasta la próxima versión del meter." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,8" ToolTip="Llegan paquetes del juego, pero el meter no los reconoce"/><Button Content="Reportar un problema" Command="{Binding ReportProblemCommand}" Style="{StaticResource ButtonSoft}" HorizontalAlignment="Left"/></StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                    </DockPanel>

                    <!-- Novedades (mock Avisos): flotan sobre el cuerpo, después de él para quedar arriba. El alto lo limita la
                         fila del cuerpo; la lista se desplaza y "Entendido" queda siempre a la vista, fuera del desplazamiento.
                         Compacta (modo compacto o cuerpo de menos de 280 px): sin el título grande, texto 12 y botón más bajo. -->
                    <Border x:Name="NewsCard" Grid.Row="1" VerticalAlignment="Top" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="10" Margin="10" Visibility="{Binding HasNotice, Converter={StaticResource Visible}}">
                        <Border.Style><Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Tag" Value="Compacta"/></DataTrigger>
                                <DataTrigger Binding="{Binding ActualHeight, ElementName=LiveBody, Converter={StaticResource OverlayNarrow}, ConverterParameter=280}" Value="True"><Setter Property="Tag" Value="Compacta"/></DataTrigger>
                            </Style.Triggers>
                        </Style></Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="18,16,18,10"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=NewsCard}" Value="Compacta"><Setter Property="Margin" Value="14,10,14,6"/></DataTrigger></Style.Triggers>
                                </Style></StackPanel.Style>
                                <TextBlock Text="{Binding NoticeKicker}" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding NoticeHeading}" Margin="0,2,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource WindowTitle}"><Setter Property="FontSize" Value="22"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoticeHeading}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, ElementName=NewsCard}" Value="Compacta"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button x:Name="NewsDismiss" DockPanel.Dock="Bottom" Content="Entendido" Command="{Binding DismissNoticeCommand}" HorizontalAlignment="Stretch" FontSize="13" ToolTip="Esc también las cierra">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}"><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="18,0,18,16"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=NewsCard}" Value="Compacta"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="14,0,14,10"/></DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                            <!-- Barra solo si queda texto afuera: con menos de 2 px sin entrar (la caja vacía debajo del último renglón)
                                 queda oculta; la rueda igual mueve ese píxel. VerticalScrollBarVisibility va en el estilo: como atributo
                                 es un valor local y le gana al disparador. -->
                            <ScrollViewer x:Name="NewsScroller" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Margin" Value="18,0,10,12"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, ElementName=NewsCard}" Value="Compacta"><Setter Property="Margin" Value="14,0,6,8"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ScrollableHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource OverlayNarrow}, ConverterParameter=2}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Hidden"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding NoticeLines}" Margin="0,0,8,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <!-- La separación va entre novedades, como el gap del mock: arriba de cada una menos la primera. Debajo de la
                                         última sumaba al alto desplazable y la barra salía con todo el texto a la vista. -->
                                    <DockPanel x:Name="NewsLine" Margin="0,10,0,0"><TextBlock DockPanel.Dock="Left" Text="◆" FontSize="11" Foreground="{DynamicResource Gold}" Margin="0,1,10,0"/><TextBlock x:Name="NewsText" Text="{Binding}" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/></DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag, ElementName=NewsCard}" Value="Compacta"><Setter TargetName="NewsLine" Property="Margin" Value="0,6,0,0"/><Setter TargetName="NewsText" Property="FontSize" Value="12"/></DataTrigger>
                                        <!-- La primera (PreviousData es null) sin separación. Va después de la de compacta para ganarle. -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}"><Setter TargetName="NewsLine" Property="Margin" Value="0"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="0,0,3,3" Visibility="{Binding CanMoveWindow, Converter={StaticResource Visible}}" Cursor="SizeNWSE" DragDelta="OnResizeDragDelta" ToolTip="Arrastrá para cambiar el tamaño · Ctrl + rueda para el zoom">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M13,3 L3,13 M13,8 L8,13 M13,12 L12,13" Stroke="{DynamicResource TextDim}" StrokeThickness="1"/></Grid></ControlTemplate></Thumb.Template>
            </Thumb>
        </Grid>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource MiniPanel}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="19" Padding="8,6,14,6" Cursor="{Binding CanMoveWindow, Converter={StaticResource MoveCursor}}" MouseLeftButtonDown="OnHeaderMouseDown" Visibility="{Binding IsMinimized, Converter={StaticResource Visible}}">
            <WrapPanel VerticalAlignment="Center">
                <ContentControl Content="{Binding PillRow}" ContentTemplate="{StaticResource MiniBadge}" VerticalAlignment="Center" Visibility="{Binding HasPillRow, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding PillRow.PerSecond}" Style="{StaticResource NumberStrong}" FontSize="20" Margin="10,0,0,0" ToolTip="{Binding RateUnit}" VerticalAlignment="Center" Visibility="{Binding HasPillRow, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding PillRankText}" FontFamily="{DynamicResource BodyFont}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPillRow, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding PillRow.Trend}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PillRow.Trend}" Value="▲"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                            <DataTrigger Binding="{Binding PillRow.Trend}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding HasPillRow}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Elapsed}" Style="{StaticResource NumberText}" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextDim}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowClock, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding MinimizedText}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasPillRow}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <Button Style="{StaticResource LiveIcon}" Width="18" Height="22" Margin="6,0,0,0" Content="↗" Command="{Binding ToggleMinimizedCommand}" ToolTip="Abrir el overlay"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
