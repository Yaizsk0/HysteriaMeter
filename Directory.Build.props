<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Permite compilar el proyecto WPF también desde Linux/macOS (CI, contenedores). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Versión que muestra un build local; el SDK le agrega el commit ("0.16.0-dev+sha"). Un release la reemplaza por
         la de su tag (-p:Version en release.yml). "-dev": no es un release y es posterior al último (0.16.0-alpha.1). -->
    <Version>0.16.0-dev</Version>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
